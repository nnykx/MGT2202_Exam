const MASTER_STREAK = 3;                // answer correctly 3 times in a row = learned (count resets)
const ICON_PAUSE = '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>';
const ICON_PLAY  = '<svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>';

/* ============================================================
   HELPERS
   ============================================================ */
const $ = id => document.getElementById(id);

function el(tag, className, text) {
  const n = document.createElement(tag);
  if (className) n.className = className;
  if (text !== undefined) n.textContent = text;
  return n;
}
function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
  return a;
}
function fmt(sec) {
  sec = Math.max(0, Math.ceil(sec));
  return [Math.floor(sec / 3600), Math.floor(sec % 3600 / 60), sec % 60].map(n => String(n).padStart(2, "0")).join(":");
}
function lsGet(k, fallback) { try { const v = JSON.parse(localStorage.getItem(k)); return v === null ? fallback : v; } catch (e) { return fallback; } }
function lsSet(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }

/* ============================================================
   EXAM SET PREPARATION
   ============================================================ */
EXAMS.forEach(set => {
  set.questions.forEach((q, i) => { if (q.id === undefined) q.id = i + 1; });
  set.qMap = new Map(set.questions.map(q => [q.id, q]));
  set.sig  = set.questions.map(q => q.id + ":" + q.opts.length).join(",");
});

function defaultSettings() { return { shuffleQ: true, shuffleO: true, timer: false, perPage: 10 }; }
function getSettings() { return Object.assign(defaultSettings(), lsGet(K_SETTINGS, {})); }

/* ============================================================
   SESSIONS (one saved attempt per exam set)
   session = { sig, order[], optOrders{}, answers{}, page, review, finished,
               cfg{shuffleQ,shuffleO,timer,perPage}, timer{total,remaining} }
   ============================================================ */
function newSession(set, cfg) {
  const order = cfg.shuffleQ ? shuffle(set.questions.map(q => q.id)) : set.questions.map(q => q.id);
  const optOrders = {};
  set.questions.forEach(q => {
    const idx = q.opts.map((_, i) => i);
    optOrders[q.id] = (cfg.shuffleO && !q.noShuffle) ? shuffle(idx) : idx;
  });
  return { sig: set.sig, order, optOrders, answers: {}, page: 0, review: false, finished: false,
           cfg: Object.assign({}, cfg), timer: { total: TIMER_SECONDS, remaining: TIMER_SECONDS } };
}
function loadSession(set) {
  const s = lsGet(K_SESSION + set.id, null);
  const ok = s && s.sig === set.sig && Array.isArray(s.order) && s.order.length === set.questions.length &&
             s.order.every(id => set.qMap.has(id)) && s.optOrders && s.answers && s.cfg && s.timer &&
             typeof s.timer.remaining === "number";
  return ok ? s : null;
}
function saveSession() { if (cur && cur.mode !== "review") lsSet(cur.key, cur.s); }

/** Count correct / wrong / answered for any session. */
function calcStats(set, s) {
  let correct = 0, wrong = 0;
  set.questions.forEach(q => {
    const a = s.answers[q.id];
    if (a === undefined) return;
    if (a === q.ans - set.answerBase) correct++; else wrong++;
  });
  return { correct, wrong, answered: correct + wrong, unanswered: set.questions.length - correct - wrong };
}

/* ============================================================
   HISTORY
   ============================================================ */
function addHistory(set, st) {
  const total = set.questions.length;
  const pct = total ? Math.round(st.correct / total * 100) : 0;
  const list = lsGet(K_HISTORY, []);
  list.unshift({ setId: set.id, title: set.title, ts: Date.now(), correct: st.correct, total, pct, isA: pct >= set.gradeA });
  lsSet(K_HISTORY, list.slice(0, 30));
}

/* ============================================================
   HOME SCREEN
   ============================================================ */
/* ---------- wrong-answer statistics (per exam set) ---------- */
function getWrongMap(setId) { return lsGet(K_WRONG + setId, {}); }

/** Count one answer. Wrong: +1. Correct: after MASTER_STREAK correct answers in a row the count resets. */
function recordAnswer(setId, qid, isCorrect) {
  const m = getWrongMap(setId);
  const e = m[qid];
  if (isCorrect) {
    if (!e) return;
    e.s = (e.s || 0) + 1;
    if (e.s >= MASTER_STREAK) delete m[qid];
  } else {
    m[qid] = { w: e ? e.w + 1 : 1, s: 0 };
  }
  lsSet(K_WRONG + setId, m);
}

/** Questions answered wrong more than twice (FREQ_WRONG = 3 or more). */
function frequentWrong(set) {
  const m = getWrongMap(set.id);
  return set.questions.filter(q => m[q.id] && m[q.id].w >= FREQ_WRONG).map(q => ({ q, w: m[q.id].w }));
}

/** Pretend exam set that only contains the given question ids (for practice mode). */
function practiceSetOf(set, ids) {
  return Object.assign({}, set, {
    questions: ids.map(id => set.qMap.get(id)),
    title: set.title + " · ฝึกข้อผิดบ่อย",
    sig: ids.join(","),
    baseSet: set
  });
}
function loadPractice(set) {
  const s = lsGet(K_SESSION + set.id + ":practice", null);
  const ok = s && !s.finished && Array.isArray(s.order) && s.order.length > 0 &&
             s.order.every(id => set.qMap.has(id)) && s.optOrders && s.answers && s.cfg && s.timer;
  return ok ? s : null;
}

/* ---------- score history ---------- */
function setStats(setId) {
  const h = lsGet(K_HISTORY, []).filter(x => x.setId === setId);
  if (!h.length) return null;
  return { n: h.length, last: h[0].pct, best: Math.max(...h.map(x => x.pct)) };
}

function histRow(h, withTime) {
  const row = el("div", "hist");
  const left = el("div");
  left.appendChild(el("b", "", h.title));
  const d = new Date(h.ts);
  let when = d.toLocaleDateString("th-TH");
  if (withTime) when += " " + d.toLocaleTimeString("th-TH", { hour: "2-digit", minute: "2-digit" });
  left.appendChild(el("span", "", `${when} • คะแนน ${h.correct}/${h.total} (${h.pct}%)`));
  row.appendChild(left);
  row.appendChild(el("div", "badge-pill" + (h.isA ? "" : " fail"), h.isA ? "เกรด A" : "ไม่ถึง A"));
  return row;
}

function openHistory() {
  const all = lsGet(K_HISTORY, []);
  const body = el("div");
  if (!all.length) body.appendChild(el("div", "sheet-text", "ยังไม่มีประวัติ"));
  all.forEach(h => body.appendChild(histRow(h, true)));
  openModal({ title: "ประวัติการสอบทั้งหมด", body, actions: [{ label: "ปิด", kind: "secondary" }] });
}

function renderHome() {
  $("siteTitle").textContent = SITE_TITLE;
  $("siteSub").textContent = SITE_SUB;
  document.title = SITE_TITLE;

  // History (latest 5)
  const hist = lsGet(K_HISTORY, []).slice(0, 5);
  $("histPanel").hidden = hist.length === 0;
  const hl = $("histList"); hl.innerHTML = "";
  hist.forEach(h => hl.appendChild(histRow(h, false)));

  // Exam set cards
  const list = $("setList"); list.innerHTML = "";
  EXAMS.forEach(set => {
    const s = loadSession(set);
    const total = set.questions.length;
    let status = "พร้อมทำ", primary = "ทำข้อสอบ";
    if (s && s.finished) {
      const st = calcStats(set, s);
      status = `เสร็จแล้ว ${Math.round(st.correct / total * 100)}%`; primary = "ทำใหม่";
    } else if (s) {
      status = `กำลังทำ ${calcStats(set, s).answered}/${total}`; primary = "ทำต่อ";
    }

    const card = el("div", "set-card");
    const top = el("div", "set-top");
    top.appendChild(el("h3", "", set.title));
    top.appendChild(el("div", "badge-pill", status));
    card.appendChild(top);
    card.appendChild(el("p", "", `${set.subtitle} · ${total} ข้อ`));

    const ss = setStats(set.id);
    if (ss) card.appendChild(el("p", "stat-line", `ทำแล้ว ${ss.n} ครั้ง · ล่าสุด ${ss.last}% · สูงสุด ${ss.best}%`));

    const actions = el("div", "set-actions");
    const b1 = el("button", "btn primary", primary); b1.type = "button";
    b1.addEventListener("click", () => {
      if (s && !s.finished) openExam(set, s, "exam");   // continue
      else openStartSheet(set);
    });
    const b2 = el("button", "btn outline", "อ่านเฉลย"); b2.type = "button";
    b2.addEventListener("click", () => openReview(set));
    actions.appendChild(b1); actions.appendChild(b2);
    card.appendChild(actions);

    // Practice mode: only the questions answered wrong too often
    const fw = frequentWrong(set);
    if (fw.length) {
      const bp = el("button", "btn practice", `ฝึกข้อที่ผิดบ่อย (${fw.length} ข้อ)`); bp.type = "button";
      bp.addEventListener("click", () => openPracticeSheet(set));
      card.appendChild(bp);
    }

    if (s && !s.finished) {
      const b3 = el("button", "btn ghost", "เริ่มใหม่"); b3.type = "button";
      b3.addEventListener("click", () => openStartSheet(set));
      card.appendChild(b3);
    }
    list.appendChild(card);
  });
}

function openPracticeSheet(set) {
  const fw = frequentWrong(set);
  const cfg = getSettings();
  const body = el("div");
  body.appendChild(el("div", "sheet-text",
    `ข้อที่ตอบผิดเกิน ${FREQ_WRONG - 1} ครั้ง (ตัวเลขคือเลขข้อตามชีท และจำนวนครั้งที่ผิด) ตอบถูกติดกัน ${MASTER_STREAK} ครั้ง ระบบจะถือว่าจำได้แล้วและนับใหม่`));
  const chips = el("div", "chips"); chips.style.margin = "12px 0";
  fw.forEach(({ q, w }) => chips.appendChild(el("span", "chip-static", `ข้อ ${q.id} · ${w} ครั้ง`)));
  body.appendChild(chips);
  body.appendChild(switchRow("สุ่มลำดับข้อ", "", cfg.shuffleQ, v => cfg.shuffleQ = v));
  body.appendChild(switchRow("สุ่มลำดับตัวเลือก", "", cfg.shuffleO, v => cfg.shuffleO = v));
  body.appendChild(segRow("จำนวนข้อต่อหน้า", [1, 5, 10, 20], cfg.perPage, v => cfg.perPage = v));

  const actions = [];
  const saved = loadPractice(set);
  if (saved) actions.push({ label: "ฝึกต่อ", onClick: () => openExam(practiceSetOf(set, saved.order), saved, "practice") });
  actions.push({ label: saved ? "เริ่มฝึกใหม่" : "เริ่มฝึก", kind: saved ? "secondary" : "", onClick: () => {
    lsSet(K_SETTINGS, cfg);
    const pset = practiceSetOf(set, fw.map(x => x.q.id));
    const s = newSession(pset, { shuffleQ: cfg.shuffleQ, shuffleO: cfg.shuffleO, timer: false, perPage: cfg.perPage });
    lsSet(K_SESSION + set.id + ":practice", s);
    openExam(pset, s, "practice");
  } });
  actions.push({ label: "ล้างสถิติข้อผิด", kind: "danger", onClick: () =>
    confirmDialog("ล้างสถิติข้อผิด?", "จำนวนครั้งที่ตอบผิดของชุดนี้จะถูกล้างทั้งหมด", "ล้างสถิติ", () => { lsSet(K_WRONG + set.id, {}); renderHome(); }) });
  actions.push({ label: "ปิด", kind: "secondary" });
  openModal({ title: "ฝึกข้อที่ผิดบ่อย · " + set.title, body, actions });
}

/** Shuffle / timer / page-size options shown right before the exam starts. */
function openStartSheet(set) {
  const cfg = getSettings();
  const body = el("div");
  body.appendChild(switchRow("สุ่มลำดับข้อ", "", cfg.shuffleQ, v => cfg.shuffleQ = v));
  body.appendChild(switchRow("สุ่มลำดับตัวเลือก", "", cfg.shuffleO, v => cfg.shuffleO = v));
  body.appendChild(switchRow("จับเวลา 2 ชั่วโมง", "หยุดเวลาได้ระหว่างทำข้อสอบ", cfg.timer, v => cfg.timer = v));
  body.appendChild(segRow("จำนวนข้อต่อหน้า", [1, 5, 10, 20], cfg.perPage, v => cfg.perPage = v));

  openModal({
    title: set.title, body,
    actions: [
      { label: "เริ่มทำข้อสอบ", onClick: () => {
          lsSet(K_SETTINGS, cfg);
          const s = newSession(set, cfg);
          lsSet(K_SESSION + set.id, s);
          openExam(set, s, "exam");
      } },
      { label: "ยกเลิก", kind: "secondary" }
    ]
  });
}

/* ============================================================
   EXAM SCREEN
   cur = { set, s (session), mode: "exam" | "review" }
   ============================================================ */
let cur = null;

function openExam(set, session, mode) {
  const base = set.baseSet || set;
  cur = { set, base, s: session, mode,
          key: mode === "practice" ? K_SESSION + base.id + ":practice" : K_SESSION + base.id };
  $("home").hidden = true;
  $("exam").hidden = false;
  try { history.pushState({ exam: true }, ""); } catch (e) {}

  const review = mode === "review";
  $("examTitle").textContent = set.title + (review ? " · อ่านเฉลย" : "");
  $("reviewToggle").hidden = review;
  $("summaryBtn").hidden = review;
  $("toolbar").hidden = review;
  $("reviewToggle").setAttribute("aria-pressed", String(!!session.review));

  renderPage();
  renderBar();
  renderTimer();
  if (!review) startTimer();
}

function openReview(set) {
  const s = newSession(set, { shuffleQ: false, shuffleO: false, timer: false, perPage: getSettings().perPage });
  s.review = true;
  openExam(set, s, "review");
}

function leaveExam() {
  if (!cur) return;
  pauseTimer();
  saveSession();
  cur = null;
  $("exam").hidden = true;
  $("home").hidden = false;
  renderHome();
}

/* ---------- question helpers ---------- */
function qAt(pos) { return cur.set.qMap.get(cur.s.order[pos]); }
function correctOrig(q) { return q.ans - cur.set.answerBase; }
function perPage() { return cur.s.cfg.perPage || 10; }
function pageCount() { return Math.max(1, Math.ceil(cur.set.questions.length / perPage())); }

function statusOf(pos) {
  const q = qAt(pos), a = cur.s.answers[q.id];
  if (a === undefined) return "unanswered";
  return a === correctOrig(q) ? "correct" : "wrong";
}

/* ---------- render a page of questions ---------- */
function buildCard(pos) {
  const q = qAt(pos), s = cur.s;
  const chosen = s.answers[q.id];
  const answered = chosen !== undefined;
  const reveal = answered || s.review || s.finished || cur.mode === "review";

  const card = el("section", "question-card");
  card.id = "q-" + pos;

  const meta = el("div", "q-meta");
  meta.appendChild(el("div", "q-number", "ข้อที่ " + (pos + 1)));
  const wm = getWrongMap(cur.base.id)[q.id];
  if (wm && wm.w >= FREQ_WRONG) meta.appendChild(el("span", "verify-tag", "ผิดบ่อย · " + wm.w + " ครั้ง"));
  card.appendChild(meta);
  card.appendChild(el("div", "q-text", q.q));

  const list = el("div", "options");
  s.optOrders[q.id].forEach((orig, i) => {
    const btn = el("button", "option");
    btn.type = "button";
    btn.appendChild(el("span", "badge", String(orig + 1)));   // original option number (matches the explanation)
    btn.appendChild(el("span", "label", q.opts[orig]));
    if (reveal) {
      btn.disabled = true;
      if (orig === correctOrig(q)) btn.classList.add("correct");
      else if (answered && orig === chosen) btn.classList.add("wrong");
      else btn.classList.add("dim");
    } else {
      btn.addEventListener("click", () => selectAnswer(pos, orig));
    }
    list.appendChild(btn);
  });
  card.appendChild(list);

  const box = el("div", "explanation" + (reveal ? " show" : ""));
  box.appendChild(el("strong", "", "คำอธิบาย"));
  box.appendChild(document.createTextNode(q.detail || "ไม่มีคำอธิบาย"));
  card.appendChild(box);
  return card;
}

function renderPage(scrollToPos) {
  const $main = $("main");
  $main.innerHTML = "";
  const n = cur.set.questions.length, pp = perPage();
  const start = cur.s.page * pp, end = Math.min(start + pp, n);
  for (let pos = start; pos < end; pos++) $main.appendChild(buildCard(pos));
  if (scrollToPos !== undefined) {
    const t = $("q-" + scrollToPos);
    if (t) t.scrollIntoView({ block: "start" });
  } else {
    $main.scrollTop = 0;
  }
}

function renderBar() {
  const n = cur.set.questions.length;
  const st = calcStats(cur.set, cur.s);
  const review = cur.mode === "review";

  $("counter").textContent = review ? `${n} ข้อ` : `ตอบแล้ว ${st.answered}/${n} · ถูก ${st.correct}`;
  $("progressBar").style.width = review ? "0" : (st.answered / n * 100) + "%";
  $("pageLabel").textContent = `หน้า ${cur.s.page + 1}/${pageCount()}`;
  $("ansLabel").textContent = review ? "แตะเพื่อเลือกข้อ" : `ตอบแล้ว ${st.answered}/${n} · แตะเพื่อเลือกข้อ`;
  $("prevBtn").disabled = cur.s.page <= 0;
  $("nextBtn").disabled = cur.s.page >= pageCount() - 1;
}

function selectAnswer(pos, orig) {
  if (cur.mode === "review" || cur.s.finished) return;
  const q = qAt(pos);
  if (cur.s.answers[q.id] !== undefined) return;
  cur.s.answers[q.id] = orig;
  recordAnswer(cur.base.id, q.id, orig === correctOrig(q));   // wrong-answer statistics
  saveSession();
  $("q-" + pos).replaceWith(buildCard(pos));   // update just this card (no scroll jump)
  renderBar();

  // All questions answered: save the result automatically
  if (Object.keys(cur.s.answers).length === cur.set.questions.length) {
    submitExam();
    openSummary(cur.mode === "practice" ? "ฝึกครบแล้ว" : "ทำครบทุกข้อ");
  }
}

function goPage(p, scrollToPos) {
  if (p < 0 || p >= pageCount()) return;
  cur.s.page = p;
  saveSession();
  renderPage(scrollToPos);
  renderBar();
}
function jumpTo(pos) { goPage(Math.floor(pos / perPage()), pos); }

/* ============================================================
   TIMER (pausing only stops the clock — the exam stays usable)
   ============================================================ */
let timerRunning = false, tickHandle = null, lastTick = 0;

function syncTimer() {
  if (!timerRunning || !cur) return;
  const now = Date.now();
  cur.s.timer.remaining = Math.max(0, cur.s.timer.remaining - (now - lastTick) / 1000);
  lastTick = now;
}
function tick() {
  syncTimer(); renderTimer(); saveSession();
  if (cur && cur.s.timer.remaining <= 0) timeUp();
}
function startTimer() {
  if (!cur || cur.mode !== "exam" || !cur.s.cfg.timer || cur.s.finished || timerRunning) return;
  timerRunning = true; lastTick = Date.now();
  clearInterval(tickHandle); tickHandle = setInterval(tick, 500);
  renderTimer();
}
function pauseTimer() {
  if (!timerRunning) return;
  syncTimer(); timerRunning = false; clearInterval(tickHandle);
  saveSession(); renderTimer();
}
function stopTimer() { timerRunning = false; clearInterval(tickHandle); }

function renderTimer() {
  const chip = $("timerChip");
  const on = cur && cur.mode === "exam" && cur.s.cfg.timer;
  chip.hidden = !on;
  if (!on) return;
  const rem = cur.s.timer.remaining;
  $("timerText").textContent = fmt(rem);
  chip.classList.toggle("warn", rem <= 600 && rem > 60);
  chip.classList.toggle("danger", rem <= 60);
  chip.classList.toggle("paused", !timerRunning && !cur.s.finished);
  const b = $("timerBtn");
  b.innerHTML = timerRunning ? ICON_PAUSE : ICON_PLAY;
  b.setAttribute("aria-label", timerRunning ? "หยุดเวลา" : "เล่นต่อ");
  b.disabled = cur.s.finished;
}

function timeUp() {
  stopTimer();
  cur.s.timer.remaining = 0;
  submitExam();
  openSummary("หมดเวลา");
}

/* ============================================================
   SUBMIT + SUMMARY
   ============================================================ */
function submitExam() {
  if (!cur || cur.s.finished) return;
  stopTimer();
  cur.s.finished = true;
  if (cur.mode === "exam") addHistory(cur.set, calcStats(cur.set, cur.s));   // practice is not recorded in history
  saveSession();
  renderPage(); renderBar(); renderTimer();
}

function openSummary(title) {
  const set = cur.set, s = cur.s;
  const st = calcStats(set, s);
  const total = set.questions.length;
  const pct = total ? Math.round(st.correct / total * 100) : 0;

  const body = el("div");
  const score = el("div", "score");
  score.appendChild(el("b", "", `${st.correct} / ${total}`));
  let sub = pct + "%";
  if (s.cfg.timer) sub += "  ·  ใช้เวลา " + fmt(s.timer.total - s.timer.remaining);
  score.appendChild(el("span", "", sub));
  body.appendChild(score);

  // Grade A status (percentage based) — not for practice mode
  if (cur.mode !== "practice") {
  const needPts = Math.ceil(set.gradeA * total / 100);
  const maxWrong = total - needPts;
  let cls = "", msg;
  if (st.correct >= needPts) { cls = "pass"; msg = `ถึงเกณฑ์เกรด A แล้ว (${set.gradeA}% = ${needPts} คะแนน)`; }
  else if (st.wrong > maxWrong) { cls = "fail"; msg = `รอบนี้ไม่ถึงเกรด A แล้ว (ผิดเกิน ${maxWrong} ข้อ)`; }
  else msg = `เกรด A ต้องได้ ${needPts} คะแนน · ขาดอีก ${needPts - st.correct} คะแนน · ผิดได้อีก ${maxWrong - st.wrong} ข้อ`;
  body.appendChild(el("div", "grade-box " + cls, msg));
  }

  const stats = el("div", "stats");
  [["ถูก", st.correct, "ok"], ["ผิด", st.wrong, "bad"], ["ยังไม่ตอบ", st.unanswered, ""]].forEach(([l, n, c]) => {
    const box = el("div", "stat " + c);
    box.appendChild(el("b", "", String(n))); box.appendChild(el("span", "", l));
    stats.appendChild(box);
  });
  body.appendChild(stats);

  let close;
  const wrongPos = [];
  for (let i = 0; i < total; i++) if (statusOf(i) === "wrong") wrongPos.push(i);
  if (wrongPos.length) {
    body.appendChild(el("div", "sub", "ข้อที่ตอบผิด (กดเพื่อไปที่ข้อนั้น)"));
    const chips = el("div", "chips");
    wrongPos.forEach(pos => {
      const c = el("button", "chip-q", String(pos + 1)); c.type = "button";
      c.addEventListener("click", () => { close(); jumpTo(pos); });
      chips.appendChild(c);
    });
    body.appendChild(chips);
  }

  const actions = [];
  if (!s.finished) {
    const pr = cur.mode === "practice";
    actions.push({ label: pr ? "จบการฝึก" : "ส่งข้อสอบและบันทึกผล", onClick: () => {
      if (st.unanswered > 0) confirmDialog(pr ? "จบการฝึก?" : "ส่งข้อสอบ?", `ยังไม่ได้ตอบอีก ${st.unanswered} ข้อ แล้วจะแก้คำตอบไม่ได้`, pr ? "จบการฝึก" : "ส่งข้อสอบ", submitExam);
      else submitExam();
    } });
  }
  actions.push({ label: "ปิด", kind: "secondary" });
  close = openModal({ title: title || "สรุปผล", body, actions });
}

/** Compact picker: a sheet with the question-number grid (replaces the big bottom grid). */
function openPicker() {
  const body = el("div");
  const legend = el("div", "legend");
  legend.innerHTML = '<span><i></i>ยังไม่ตอบ</span><span><i class="c"></i>ถูก</span><span><i class="w"></i>ผิด</span>';
  body.appendChild(legend);

  let close;
  const grid = el("div", "grid");
  const n = cur.set.questions.length;
  for (let i = 0; i < n; i++) {
    const d = el("button", "dot", String(i + 1)); d.type = "button";
    const s = statusOf(i);
    if (s !== "unanswered") d.classList.add(s);
    if (Math.floor(i / perPage()) === cur.s.page && i === cur.s.page * perPage()) d.classList.add("current");
    d.addEventListener("click", () => { close(); jumpTo(i); });
    grid.appendChild(d);
  }
  body.appendChild(grid);

  const actions = [];
  if (cur.mode !== "review") {
    const firstOpen = Array.from({ length: n }, (_, i) => i).find(i => statusOf(i) === "unanswered");
    if (firstOpen !== undefined) actions.push({ label: "ไปข้อที่ยังไม่ตอบข้อแรก", onClick: () => jumpTo(firstOpen) });
  }
  actions.push({ label: "ปิด", kind: "secondary" });
  close = openModal({ title: "เลือกข้อ", body, actions });
}

/* ============================================================
   MODALS + SMALL CONTROLS
   ============================================================ */
function openModal({ title, body, actions = [] }) {
  const backdrop = el("div", "sheet-backdrop");
  const sheet = el("div", "sheet");
  sheet.setAttribute("role", "dialog"); sheet.setAttribute("aria-modal", "true");
  sheet.appendChild(el("div", "sheet-title", title));
  if (body) sheet.appendChild(body);
  const close = () => backdrop.remove();
  if (actions.length) {
    const row = el("div", "sheet-actions");
    actions.forEach(a => {
      const btn = el("button", "nav-btn " + (a.kind || ""), a.label); btn.type = "button";
      btn.addEventListener("click", () => { close(); if (a.onClick) a.onClick(); });
      row.appendChild(btn);
    });
    sheet.appendChild(row);
  }
  backdrop.appendChild(sheet);
  backdrop.addEventListener("click", e => { if (e.target === backdrop) close(); });
  document.body.appendChild(backdrop);
  return close;
}
function confirmDialog(title, message, confirmLabel, onConfirm) {
  openModal({ title, body: el("div", "sheet-text", message),
    actions: [{ label: confirmLabel, onClick: onConfirm }, { label: "ยกเลิก", kind: "secondary" }] });
}
function switchRow(label, hint, checked, onChange) {
  const row = el("div", "row");
  const text = el("div");
  text.appendChild(el("div", "row-label", label));
  if (hint) text.appendChild(el("div", "row-hint", hint));
  const sw = el("button", "switch"); sw.type = "button";
  sw.setAttribute("role", "switch"); sw.setAttribute("aria-checked", String(checked)); sw.setAttribute("aria-label", label);
  sw.addEventListener("click", () => {
    const next = sw.getAttribute("aria-checked") !== "true";
    sw.setAttribute("aria-checked", String(next)); onChange(next);
  });
  row.appendChild(text); row.appendChild(sw);
  return row;
}
function segRow(label, values, current, onChange) {
  const row = el("div", "row");
  row.appendChild(el("div", "row-label", label));
  const seg = el("div", "seg");
  values.forEach(v => {
    const b = el("button", v === current ? "on" : "", String(v)); b.type = "button";
    b.addEventListener("click", () => {
      seg.querySelectorAll("button").forEach(x => x.classList.remove("on"));
      b.classList.add("on"); onChange(v);
    });
    seg.appendChild(b);
  });
  row.appendChild(seg);
  return row;
}

/* ============================================================
   EVENTS
   ============================================================ */
$("prevBtn").addEventListener("click", () => goPage(cur.s.page - 1));
$("nextBtn").addEventListener("click", () => goPage(cur.s.page + 1));
$("listBtn").addEventListener("click", openPicker);
$("histAll").addEventListener("click", openHistory);
$("summaryBtn").addEventListener("click", () => openSummary("สรุปผล"));
$("timerBtn").addEventListener("click", () => { timerRunning ? pauseTimer() : startTimer(); });
$("reviewToggle").addEventListener("click", () => {
  cur.s.review = !cur.s.review;
  $("reviewToggle").setAttribute("aria-pressed", String(cur.s.review));
  saveSession(); renderPage(); renderBar();
});

// Back: use the browser history so the phone's back gesture also returns home
$("backBtn").addEventListener("click", () => {
  if (history.state && history.state.exam) history.back(); else leaveExam();
});
window.addEventListener("popstate", () => { if (cur) leaveExam(); });

function flush() { syncTimer(); saveSession(); }
window.addEventListener("beforeunload", flush);
window.addEventListener("pagehide", flush);
document.addEventListener("visibilitychange", () => { if (document.hidden) flush(); });

/* ============================================================
   INIT
   ============================================================ */
renderHome();
</script>
