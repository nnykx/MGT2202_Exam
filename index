<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#05060F">
<title>Exam</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Prompt:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  /* ============================================================
     THEME — change these variables to re-skin the whole app
     ============================================================ */
  :root {
    --bg: #05060F;
    --card: #0E1124;
    --card-2: #151A38;
    --accent: #6366F1;
    --accent-soft: rgba(99, 102, 241, 0.18);
    --title: #A5B4FC;
    --text: #E8EAFE;
    --muted: #9CA3C8;
    --border: rgba(129, 140, 248, 0.2);
    --peach: #FDBA8C;

    --correct: #22C55E;
    --correct-bg: rgba(34, 197, 94, 0.16);
    --wrong: #EF4444;
    --wrong-bg: rgba(239, 68, 68, 0.16);
    --warn: #F59E0B;

    --radius-lg: 18px;
    --radius-md: 14px;
    --shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    --ease: 0.25s ease;
    --font: "Prompt", "Sarabun", system-ui, -apple-system, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font-family: var(--font); }
  button { font-family: var(--font); }

  .app { height: 100vh; height: 100dvh; max-width: 560px; margin: 0 auto; position: relative; }
  .screen { height: 100%; display: flex; flex-direction: column; }
  .screen[hidden] { display: none; }

  /* ================= HOME ================= */
  .home { overflow-y: auto; padding: calc(24px + env(safe-area-inset-top)) 18px calc(32px + env(safe-area-inset-bottom)); }
  .hero {
    text-align: center; padding: 28px 16px;
    border-radius: 26px; border: 2px solid rgba(99, 102, 241, 0.35);
    background: linear-gradient(160deg, #0D1030, #060818);
    box-shadow: var(--shadow);
  }
  .hero h1 { margin: 0; font-size: 2rem; font-weight: 600; color: var(--title); }
  .hero p { margin: 6px 0 0; color: var(--muted); font-size: 1.05rem; }

  .panel { margin-top: 20px; padding: 20px; background: var(--card); border: 1px solid var(--border); border-radius: 22px; }
  .panel h2 { margin: 0 0 14px; font-size: 1.3rem; font-weight: 600; color: var(--title); }
  .section-title { margin: 28px 2px 12px; font-size: 1.25rem; font-weight: 600; }

  .hist { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px dashed var(--border); }
  .hist:last-child { border-bottom: 0; padding-bottom: 0; }
  .hist:first-of-type { padding-top: 0; }
  .hist b { display: block; font-size: 1.05rem; font-weight: 600; }
  .hist span { font-size: 0.85rem; color: var(--muted); }
  .badge-pill {
    flex: none; padding: 6px 14px; border-radius: 10px;
    background: var(--accent-soft); color: var(--title);
    font-size: 0.85rem; font-weight: 600; white-space: nowrap;
  }
  .badge-pill.fail { background: var(--wrong-bg); color: #FCA5A5; }

  .set-card { margin-bottom: 14px; padding: 20px; background: var(--card); border: 1px solid var(--border); border-radius: 22px; }
  .set-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .set-top h3 { margin: 0; font-size: 1.3rem; font-weight: 600; }
  .set-card p { margin: 4px 0 14px; color: var(--muted); font-size: 0.9rem; }
  .set-actions { display: flex; gap: 10px; }
  .btn {
    padding: 14px; border-radius: 14px; border: 1.5px solid transparent;
    font: 600 1rem var(--font); cursor: pointer; transition: transform 0.12s ease, opacity var(--ease);
  }
  .btn:active { transform: scale(0.97); }
  .btn.primary { flex: 1; background: var(--accent); color: #fff; }
  .btn.outline { padding: 14px 20px; background: transparent; color: var(--peach); border-color: var(--peach); }
  .btn.ghost { margin-top: 10px; width: 100%; padding: 8px; background: transparent; color: var(--muted); font-size: 0.85rem; font-weight: 500; }

  /* ================= EXAM ================= */
  .header { flex: none; padding: calc(10px + env(safe-area-inset-top)) 14px 10px; background: var(--card); box-shadow: var(--shadow); z-index: 5; }
  .header-top { display: flex; align-items: center; gap: 10px; }
  .icon-btn {
    flex: none; width: 38px; height: 38px; border-radius: 50%;
    border: 1px solid var(--border); background: transparent; color: var(--text);
    display: grid; place-items: center; cursor: pointer; padding: 0; font-size: 1.2rem;
  }
  .head-text { flex: 1; min-width: 0; }
  .title { font-size: 1rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .counter { font-size: 0.76rem; color: var(--muted); margin-top: 1px; }

  .toggle {
    flex: none; display: flex; align-items: center; gap: 8px; padding: 6px 11px 6px 9px;
    border: 1px solid var(--border); border-radius: 999px; background: transparent;
    color: var(--text); font: 500 0.78rem var(--font); cursor: pointer;
    transition: background var(--ease), border-color var(--ease);
  }
  .toggle[hidden] { display: none; }
  .toggle .track { width: 28px; height: 16px; border-radius: 999px; background: rgba(255,255,255,0.18); position: relative; transition: background var(--ease); }
  .toggle .track::after { content: ""; position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: #fff; transition: transform var(--ease); }
  .toggle[aria-pressed="true"] { background: var(--accent-soft); border-color: var(--accent); }
  .toggle[aria-pressed="true"] .track { background: var(--accent); }
  .toggle[aria-pressed="true"] .track::after { transform: translateX(12px); }

  .toolbar { display: flex; align-items: center; gap: 8px; margin-top: 8px; }
  .toolbar[hidden] { display: none; }
  .spacer { flex: 1; }
  .chip {
    display: flex; align-items: center; gap: 6px; padding: 3px 3px 3px 12px; border-radius: 999px;
    background: rgba(255,255,255,0.08); border: 1px solid var(--border);
    font-variant-numeric: tabular-nums; font-weight: 500; font-size: 0.88rem;
  }
  .chip[hidden] { display: none; }
  .chip.warn { color: var(--warn); border-color: var(--warn); }
  .chip.danger { color: var(--wrong); border-color: var(--wrong); }
  .chip.paused { opacity: 0.8; }
  .chip-btn { width: 26px; height: 26px; border-radius: 50%; border: 0; background: var(--accent); color: #fff; display: grid; place-items: center; cursor: pointer; padding: 0; }
  .chip-btn:disabled { opacity: 0.35; cursor: default; }
  .pill { padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: transparent; color: var(--text); font: 500 0.8rem var(--font); cursor: pointer; }
  .pill[hidden] { display: none; }

  .progress { flex: none; height: 3px; background: rgba(255,255,255,0.06); }
  .progress > div { height: 100%; width: 0; background: var(--accent); transition: width 0.35s ease; }

  .main { flex: 1; min-height: 0; overflow-y: auto; padding: 14px; -webkit-overflow-scrolling: touch; }

  .question-card {
    scroll-margin-top: 8px; margin-bottom: 16px; padding: 18px 16px;
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius-lg); box-shadow: var(--shadow);
  }
  .q-meta { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
  .q-number { font-size: 0.8rem; color: var(--title); font-weight: 600; }
  .verify-tag { font-size: 0.7rem; color: var(--warn); border: 1px solid var(--warn); border-radius: 999px; padding: 2px 9px; white-space: nowrap; }
  .q-text { font-size: 1.02rem; line-height: 1.65; font-weight: 500; white-space: pre-line; }

  .options { display: flex; flex-direction: column; gap: 9px; margin-top: 14px; }
  .option {
    display: flex; align-items: flex-start; gap: 12px; width: 100%; padding: 12px 13px; text-align: left;
    background: var(--card-2); color: var(--text); border: 1.5px solid var(--border);
    border-radius: var(--radius-md); font: 400 0.96rem/1.5 var(--font); cursor: pointer;
    transition: background var(--ease), border-color var(--ease), transform 0.12s ease;
  }
  .option:active:not(:disabled) { transform: scale(0.985); }
  .option:disabled { cursor: default; }
  @media (hover: hover) { .option:hover:not(:disabled) { border-color: var(--accent); } }
  .option .badge { flex: none; width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,0.1); font-size: 0.78rem; font-weight: 600; }
  .option .label { flex: 1; padding-top: 1px; }
  .option.correct { background: var(--correct-bg); border-color: var(--correct); }
  .option.correct .badge { background: var(--correct); color: #06280F; }
  .option.wrong { background: var(--wrong-bg); border-color: var(--wrong); }
  .option.wrong .badge { background: var(--wrong); color: #fff; }
  .option.dim { opacity: 0.55; }

  .explanation { display: none; margin-top: 14px; padding: 14px; background: var(--accent-soft); border-left: 4px solid var(--accent); border-radius: var(--radius-md); font-size: 0.91rem; line-height: 1.7; white-space: pre-line; }
  .explanation.show { display: block; animation: fadeIn 0.45s ease both; }
  .explanation strong { display: block; margin-bottom: 4px; color: var(--title); font-weight: 600; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  /* ---------- Compact bottom bar ---------- */
  .bottom {
    flex: none; display: flex; align-items: center; gap: 8px;
    padding: 8px 12px calc(8px + env(safe-area-inset-bottom));
    background: var(--card); border-radius: 18px 18px 0 0; box-shadow: 0 -6px 20px rgba(0,0,0,0.4); z-index: 5;
  }
  .nav-btn { flex: none; padding: 10px 14px; border: 0; border-radius: 12px; background: var(--accent); color: #fff; font: 500 0.9rem var(--font); cursor: pointer; }
  .nav-btn.secondary { background: rgba(255,255,255,0.1); }
  .nav-btn.danger { background: var(--wrong); }
  .nav-btn:active:not(:disabled) { transform: scale(0.96); }
  .nav-btn:disabled { opacity: 0.3; cursor: default; }
  .list-btn {
    flex: 1; min-width: 0; padding: 6px 8px; border-radius: 12px; border: 1px solid var(--border);
    background: transparent; color: var(--text); cursor: pointer; line-height: 1.25;
  }
  .list-btn b { display: block; font-size: 0.86rem; font-weight: 600; }
  .list-btn span { display: block; font-size: 0.72rem; color: var(--muted); }

  /* ---------- Bottom sheets ---------- */
  .sheet-backdrop { position: fixed; inset: 0; z-index: 100; background: rgba(0,0,0,0.6); display: flex; align-items: flex-end; justify-content: center; animation: fadeOnly 0.2s ease both; }
  .sheet {
    width: 100%; max-width: 560px; max-height: 88dvh; overflow-y: auto; background: var(--card);
    border: 1px solid var(--border); border-bottom: 0; border-radius: 22px 22px 0 0;
    padding: 20px 18px calc(18px + env(safe-area-inset-bottom)); animation: slideUp 0.28s ease both;
  }
  .sheet-title { font-size: 1.1rem; font-weight: 600; margin-bottom: 12px; }
  .sheet-text { color: var(--muted); line-height: 1.65; font-size: 0.93rem; }
  .sheet-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
  .sheet-actions .nav-btn { padding: 13px; font-size: 0.95rem; }
  @keyframes fadeOnly { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideUp { from { transform: translateY(40px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }
  .row:last-of-type { border-bottom: 0; }
  .row-label { font-weight: 500; }
  .row-hint { font-size: 0.78rem; color: var(--muted); margin-top: 2px; }
  .switch { flex: none; width: 46px; height: 26px; border-radius: 999px; border: 0; padding: 0; position: relative; cursor: pointer; background: rgba(255,255,255,0.2); transition: background var(--ease); }
  .switch::after { content: ""; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform var(--ease); }
  .switch[aria-checked="true"] { background: var(--accent); }
  .switch[aria-checked="true"]::after { transform: translateX(20px); }
  .seg { display: flex; gap: 6px; }
  .seg button { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border); background: transparent; color: var(--text); font: 500 0.82rem var(--font); cursor: pointer; }
  .seg button.on { background: var(--accent); border-color: var(--accent); }

  /* Question picker grid (inside a sheet) */
  .legend { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 12px; font-size: 0.78rem; color: var(--muted); }
  .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 5px; background: rgba(255,255,255,0.2); }
  .legend i.c { background: var(--correct); } .legend i.w { background: var(--wrong); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(40px, 1fr)); gap: 8px; }
  .dot { aspect-ratio: 1; border-radius: 50%; border: 1.5px solid var(--border); background: rgba(255,255,255,0.06); color: var(--text); font: 500 0.8rem var(--font); display: grid; place-items: center; cursor: pointer; padding: 0; }
  .dot.correct { background: var(--correct); border-color: var(--correct); color: #06280F; }
  .dot.wrong { background: var(--wrong); border-color: var(--wrong); color: #fff; }
  .dot.current { outline: 2px solid var(--title); outline-offset: 2px; }

  /* Summary */
  .score { text-align: center; margin: 4px 0 14px; }
  .score b { font-size: 2.2rem; font-weight: 600; }
  .score span { display: block; color: var(--muted); font-size: 0.9rem; margin-top: 2px; }
  .grade-box { margin-bottom: 14px; padding: 12px 14px; border-radius: var(--radius-md); border: 1.5px solid var(--border); background: rgba(255,255,255,0.05); font-size: 0.9rem; line-height: 1.6; text-align: center; }
  .grade-box.pass { border-color: var(--correct); background: var(--correct-bg); }
  .grade-box.fail { border-color: var(--wrong); background: var(--wrong-bg); }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .stat { padding: 12px 6px; text-align: center; border-radius: var(--radius-md); background: rgba(255,255,255,0.05); }
  .stat b { display: block; font-size: 1.3rem; }
  .stat span { font-size: 0.78rem; color: var(--muted); }
  .stat.ok b { color: var(--correct); } .stat.bad b { color: var(--wrong); }
  .sub { margin: 16px 0 8px; font-size: 0.85rem; color: var(--muted); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip-q { min-width: 38px; height: 34px; padding: 0 10px; border-radius: 999px; border: 1.5px solid var(--wrong); background: var(--wrong-bg); color: var(--text); font: 500 0.82rem var(--font); cursor: pointer; }

  .panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .panel-head h2 { margin: 0; }
  .link-btn { background: transparent; border: 0; color: var(--title); font: 500 0.85rem var(--font); cursor: pointer; padding: 4px 0; }
  .set-card p.stat-line { margin: -8px 0 12px; font-size: 0.8rem; color: var(--title); }
  .btn.practice { width: 100%; margin-top: 10px; background: transparent; color: var(--title); border-color: var(--accent); }
  .chip-static { display: inline-block; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--warn); background: rgba(245, 158, 11, 0.12); color: var(--text); font: 500 0.8rem var(--font); }
  .hist-date { font-size: 0.85rem; color: var(--muted); }

  button:focus-visible { outline: 2px solid #A5B4FC; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
  @media (min-width: 600px) { body { background: #02030A; } .app { box-shadow: 0 0 60px rgba(0,0,0,0.6); } }
</style>
</head>

<body>
<div class="app">

  <!-- ================= HOME ================= -->
  <section class="screen home" id="home">
    <div class="hero"><h1 id="siteTitle"></h1><p id="siteSub"></p></div>
    <div class="panel" id="histPanel" hidden>
      <div class="panel-head"><h2>ประวัติการสอบล่าสุด</h2><button class="link-btn" id="histAll" type="button">ดูทั้งหมด</button></div>
      <div id="histList"></div>
    </div>
    <div class="section-title">เลือกชุดข้อสอบ</div>
    <div id="setList"></div>
  </section>

  <!-- ================= EXAM ================= -->
  <section class="screen" id="exam" hidden>
    <header class="header">
      <div class="header-top">
        <button class="icon-btn" id="backBtn" type="button" aria-label="กลับหน้าหลัก">‹</button>
        <div class="head-text">
          <div class="title" id="examTitle"></div>
          <div class="counter" id="counter"></div>
        </div>
        <button class="toggle" id="reviewToggle" type="button" aria-pressed="false">
          <span class="track"></span><span>เฉลย</span>
        </button>
      </div>
      <div class="toolbar" id="toolbar">
        <div class="chip" id="timerChip" hidden>
          <span id="timerText">02:00:00</span>
          <button class="chip-btn" id="timerBtn" type="button" aria-label="หยุดเวลา"></button>
        </div>
        <span class="spacer"></span>
        <button class="pill" id="summaryBtn" type="button">สรุปผล</button>
      </div>
    </header>
    <div class="progress"><div id="progressBar"></div></div>

    <main class="main" id="main"></main>

    <nav class="bottom" aria-label="Page navigation">
      <button class="nav-btn secondary" id="prevBtn" type="button">‹ ก่อนหน้า</button>
      <button class="list-btn" id="listBtn" type="button" aria-label="เลือกข้อ">
        <b id="pageLabel">หน้า 1/1</b><span id="ansLabel"></span>
      </button>
      <button class="nav-btn" id="nextBtn" type="button">ถัดไป ›</button>
    </nav>
  </section>
</div>

<script>
/* ============================================================
   EXAM SET: ชีทแดง S/66 (MGT 2202 / GM 315, 100 ข้อ)
   Each item = { id, q, opts[5], ans, detail }   (ans นับจาก 1)
   Q(...) is just a short-hand that builds that object.
   verify = 1  -> shows " ตรวจกับต้นฉบับ" on the question card
   noShuffle  -> keep the option order fixed
   ============================================================ */
const Q = (id, q, opts, ans, detail, verify, noShuffle) => {
  const o = { id, q, opts, ans, detail };
  if (verify) o.verify = true;
  if (noShuffle) o.noShuffle = true;
  return o;
};

const EXAM_RED_S66 = [
Q(1,"แหล่งที่มาของข้อมูลเพื่อใช้ในการจัดทำรายงานแหล่งใดถือเป็นข้อมูลทุติยภูมิ",
 ["การสัมภาษณ์","ออกแบบสอบถาม","ผลการทดลอง","วารสาร","ผลงานวิจัย"],4,
 " หลักการ: ข้อมูลที่ใช้ทำรายงานแบ่งตามแหล่งที่มาเป็น 2 ประเภท\n• ปฐมภูมิ (Primary) = ผู้ทำรายงานลงมือหาข้อมูลมาเอง เป็นข้อมูลมือหนึ่ง เช่น แบบสอบถาม การสัมภาษณ์ ผลการทดลอง ผลงานวิจัยที่เราทำเอง\n• ทุติยภูมิ (Secondary) = มีคนอื่นสำรวจหรือเรียบเรียงไว้แล้ว เราหยิบมาใช้ต่อ เช่น หนังสือ วารสาร สิ่งพิมพ์ เอกสารของทางราชการ\n\nวิเคราะห์ตัวเลือก: ข้อ 1, 2, 3, 5 เป็นข้อมูลที่ผู้ทำรายงานเก็บเอง จึงเป็นปฐมภูมิ มีเพียง 'วารสาร' ที่คนอื่นเขียนไว้ก่อนแล้ว\n\nวิธีจำ: ปฐม = ลำดับที่หนึ่ง/เก็บเอง, ทุติย = ลำดับที่สอง/ใช้ของที่มีคนทำไว้"),
Q(2,"การทำดัชนี คืออะไร",
 ["การจัดเอกสารที่ต้องการโอนแยกไปไว้กับเอกสารอื่น","การแสดงความเกี่ยวข้องระหว่างเอกสารในแฟ้มกับเอกสารอื่น","การเลือกหน่วยที่จะเก็บโดยใช้ชื่อเป็นชื่อแฟ้มเพื่อช่วยในการค้นหา","การทำเครื่องหมายบนเอกสารที่จะเก็บเพื่อบอกแหล่งที่จะนำไปเก็บ","การนำเอกสารเข้าเก็บไว้ในแฟ้มที่เตรียมไว้"],3,
 "อ้างอิง: หน้า 214\n\nหลักการ: ก่อนเก็บเอกสารต้องตัดสินใจ 2 เรื่องที่มักถูกนำมาถามสลับกัน\n• การทำดัชนี (Indexing) = เลือกว่าจะใช้ 'ชื่ออะไร' เป็นชื่อแฟ้ม เพื่อให้เก็บและค้นหาภายหลังได้ง่าย\n• การทำรหัส (Coding) = ลงมือทำเครื่องหมายบนเอกสาร เช่น ใช้ดินสอสีขีดเส้นใต้ หรือวงล้อมรอบชื่อดัชนี เพื่อบอกว่าเอกสารนี้จะไปเก็บที่แฟ้มไหน\n\nวิเคราะห์ตัวเลือก: ข้อ 4 คือคำนิยามของ 'การทำรหัส' (ออกข้อสอบในข้อ 32) ส่วนข้อ 1, 2, 5 ไม่ใช่นิยามของดัชนี\n\nวิธีจำ: ดัชนี = เลือกชื่อ (คิด) / รหัส = ทำเครื่องหมาย (ลงมือ)"),
Q(3,"เอกสารประเภทใด มีประโยชน์เพื่อใช้ในการปฏิบัติงานภายในระยะเวลา 4 – 5 สัปดาห์",
 ["Vital","Important","Helpful","Secret","Nonessential"],3,
 "อ้างอิง: หน้า 198–199\n\nหลักการ: จำแนกเอกสารตามความสำคัญเป็น 4 ประเภท เรียงจากอายุการใช้งานสั้นไปยาว\n1) Nonessential (ไม่จำเป็น) = คุณค่าอยู่ในระยะเวลาสั้น ๆ\n2) Helpful (มีประโยชน์) = ใช้ปฏิบัติงานภายใน 4–5 สัปดาห์ เช่น จดหมายเวียนต่าง ๆ\n3) Important (สำคัญ) = มีคุณค่านานตั้งแต่ 5–6 ปีขึ้นไป ควรเก็บไว้อ้างอิง เช่น อัตราค่าจ้าง\n4) Vital (คุณค่าสูง) = มีคุณค่าต่อชีวิตขององค์การ ต้องเก็บไว้ตลอดไป ได้แก่ เอกสารด้านกฎหมาย เช่น หนังสือสำคัญแสดงการเป็นเจ้าของกิจการ/ทรัพย์สิน/หนี้สิน (พันธบัตร หุ้นกู้ ทะเบียนรถ โฉนดที่ดิน งบแสดงฐานะการเงิน รายงานประจำปี) และหนังสือสัญญาต่าง ๆ (สัญญากับสหภาพแรงงาน ข้อตกลงกับลูกจ้าง สัญญาซื้อขายที่ดิน สัญญาว่าจ้างทำงาน)\n\nวิเคราะห์: โจทย์บอกช่วงเวลา '4–5 สัปดาห์' ซึ่งเป็นคำสำคัญของ Helpful ส่วน Secret ไม่ใช่ 1 ใน 4 ประเภทนี้เลย\n\nวิธีจำ: สัปดาห์ = Helpful / ปี = Important / ตลอดไป = Vital / ไม่คุ้มเก็บ = Nonessential\n(ข้อนี้เป็นฐานของข้อ 11, 51, 68, 98)"),
Q(4,"อุปกรณ์แสดงผลข้อมูลคอมพิวเตอร์ คือข้อใด",
 ["Touch Screen","Scanner","Monitor","Keyboard","Modem"],3,
 "อ้างอิง: หน้า 105–106\n\nหลักการ: คอมพิวเตอร์มีองค์ประกอบสำคัญ 4 ส่วน เปรียบกับร่างกายมนุษย์ได้ดังนี้\n1) อุปกรณ์รับ/ป้อนข้อมูล (Input) = นำข้อมูลเข้าสู่ระบบ ได้แก่ แป้นพิมพ์ (Keyboard) เมาส์ จอสัมผัส (Touch Screen) สแกนเนอร์ แหล่งข้อมูลอัตโนมัติ ฯลฯ เปรียบเหมือนอวัยวะรับสัมผัส เช่น ตา หู จมูก\n2) หน่วยประมวลผลกลาง (CPU) = ควบคุมการทำงานตามคำสั่งและคำนวณค่า เปรียบเหมือนสมอง\n3) อุปกรณ์แสดงผล (Output) = นำข้อมูลที่ประมวลผลแล้วออกมาแสดง ได้แก่ จอภาพ (Monitor) เครื่องพิมพ์ (Printer) ฯลฯ เปรียบเหมือนปากหรือแขนขา\n4) หน่วยความจำ (Memory) = เก็บข้อมูลและคำสั่ง มี 2 ส่วนคือหน่วยความจำหลักและสำรอง เปรียบเหมือนสมองบริเวณความจำ\n\nวิเคราะห์ตัวเลือก: Touch Screen, Scanner, Keyboard เป็น Input ส่วน Modem เป็นอุปกรณ์สื่อสาร ไม่ใช่อุปกรณ์แสดงผล\n\nกับดัก: Touch Screen ชื่อมีคำว่า Screen แต่เป็น Input ตามเฉลยของชีทนี้"),
Q(5,"การจัดเรียงลำดับตามระบบตัวอักษรที่เป็นชื่อกิจการที่เป็นตัวเลข ข้อใดถูกต้องตามหลักวิชา\n1. 99 Store  2. 17 Hair style  3. 24 Coffee corner\n4. 60 Book store  5. 89 Gym  6. 33 Pet shop",
 ["5, 3, 1, 2, 4, 6","3, 5, 1, 4, 6, 2","5, 1, 2, 4, 6, 3","1, 2, 5, 4, 6, 3","4, 2, 6, 5, 3, 1"],3,
 "อ้างอิง: หน้า 207–208, 212–213\n\nหลักการเรียงชื่อกิจการตามตัวอักษร\n• เรียงตามตัวอักษร (ถ้าเป็นภาษาไทยให้เรียงตามหลักพจนานุกรมไทย)\n• ถ้าชื่อเป็นตัวเลข ให้ 'อ่านออกเสียงเป็นตัวหนังสือ' แล้วเรียงตามตัวสะกดนั้น\n• พิจารณาเฉพาะชื่อจริง ๆ ส่วนยศ คำนำหน้านาม หรือคำว่า ร้าน บริษัท โรงงาน ห้างหุ้นส่วนจำกัด ไม่นำมาเรียง แต่ใส่วงเล็บไว้ข้างหลังสุด\n\nขั้นตอนทำ: แปลงเลขเป็นคำอ่านก่อน\n99 = Ninety-nine (1) / 17 = Seventeen (2) / 24 = Twenty-four (3) / 60 = Sixty (4) / 89 = Eighty-nine (5) / 33 = Thirty-three (6)\nเรียง A–Z: Eighty-nine (E) → Ninety-nine (N) → Seventeen (Se) → Sixty (Si) → Thirty-three (Th) → Twenty-four (Tw)\nSe มาก่อน Si เพราะ e มาก่อน i, Th มาก่อน Tw เพราะ h มาก่อน w\n= ข้อ 5, 1, 2, 4, 6, 3\n\nกับดัก: อย่าเรียงตามค่าตัวเลข (17, 24, 33...) ให้ 'อ่านเป็นคำ' เสมอ"),
Q(6,"การเรียงชื่อบุคคลธรรมดาตามระบบตัวอักษร ข้อใดถูกต้องที่สุด\n1. นางปริญญา ชื่นชม  2. แพทย์หญิงไปรมา เจริญดี  3. เด็กหญิงปรางค์ พึ่งพอใจ\n4. ร้อยเอกปรีดีพงษ์ สุขใจ  5. พันตำรวจตรีเปรื่อง ผาสุก  6. ศาสตราจารย์ประทีบ ใจชื่อ",
 ["4, 2, 3, 6, 5, 1","6, 3, 1, 4, 5, 2","2, 1, 6, 5, 3, 4","6, 3, 5, 4, 1, 2","2, 6, 4, 3, 1, 5"],2,
 " หลักการเรียงชื่อบุคคล (ดูข้อ 5 ประกอบ)\n• ตัดยศ ตำแหน่ง คำนำหน้านาม (นาง แพทย์หญิง เด็กหญิง ร้อยเอก พันตำรวจตรี ศาสตราจารย์) ออก ไม่นำมาใช้เรียง แต่ใส่ในวงเล็บไว้ท้ายชื่อ\n• เรียงตามชื่อตัวก่อน ถ้าชื่อตัวเหมือนกันค่อยดูนามสกุล\n\nผลการเรียงตามเฉลย:\n1) ประทีบ ใจชื่อ (ศาสตราจารย์) = ข้อ 6\n2) ปรางค์ พึ่งพอใจ (เด็กหญิง) = ข้อ 3\n3) ปริญญา ชื่นชม (นาง) = ข้อ 1\n4) ปรีดีพงษ์ สุขใจ (ร้อยเอก) = ข้อ 4\n5) เปรื่อง ผาสุก (พันตำรวจตรี) = ข้อ 5\n6) ไปรมา เจริญดี (แพทย์หญิง) = ข้อ 2\n\nสังเกต: ทุกชื่อขึ้นต้นด้วย 'ปร' จึงดูตัวถัดไป: ะ → า → ิ → ี (ประ, ปรา, ปริ, ปรี) ส่วนชื่อที่เขียนสระหน้า เ- และ ไ- (เปรื่อง, ไปรมา) เฉลยวางไว้ท้ายสุดตามลำดับนี้ ให้จำเป็นลำดับของข้อนี้ได้เลย"),
Q(7,"แผนผังลำดับขั้นการปฏิบัติงานนี้ตรงกับข้อใด\nพิมพ์ต้นฉบับข้อสอบ – ตรวจสอบความถูกต้อง – จัดรูปแบบ – ส่งไปแผนกถ่ายฟิล์ม – ถ่ายฟิล์มข้อสอบ – ตรวจสอบฟิล์มข้อสอบ – รอตัดแต่งฟิล์ม – ตัดแต่งฟิล์มทำต้นฉบับเป็นเพลท – เก็บสำเนา – นำต้นฉบับฟิล์มถ่ายเป็นเพลท – ตรวจสอบความถูกต้องของเพลทเข้าเครื่องพิมพ์ – ส่งไปเข้าแท่นพิมพ์ข้อสอบ – เข้ากระบวนการพิมพ์สำเนาข้อสอบ",
 ["○ → ⇨ → ▽ → ○ → D → ⇨ → ○ → □ → ⇨ → ○ → □ → ▽ → ○","○ → ⇨ → ○ → D → ⇨ → ○ → ▽ → ○ → D → ○ → □ → ⇨ → ○","○ → ⇨ → ○ → □ → ○ → ▽ → D → ⇨ → ○ → □ → ▽ → ⇨ → ○","○ → □ → ⇨ → ○ → □ → D → ⇨ → ○ → ▽ → ○ → □ → ⇨ → ○","○ → □ → ○ → ⇨ → ○ → □ → D → ○ → ▽ → ○ → □ → ⇨ → ○"],5,
 "อ้างอิง: หน้า 175–178\n\nสัญลักษณ์ 5 ตัวในแผนผังลำดับขั้นการปฏิบัติงาน\n○ Operation = การปฏิบัติ คือ ลงมือทำงาน เช่น รับคำสั่งซื้อ พิมพ์ใบสั่งขาย จัดทำหลักฐานเบิกจ่ายเงิน จัดทำบัญชี อนุมัติสินเชื่อ\n⇨ Transportation = การเดินทาง คือ เคลื่อนย้ายงานจากคนหรือสถานที่หนึ่งไปอีกที่ เช่น ส่งหลักฐาน ส่งผู้เกี่ยวข้อง\n▽ Storage = การเก็บ เช่น เก็บสำเนา เก็บเข้าแฟ้ม เก็บในตู้เซฟ\nD Delay = การล่าช้า คือ การรอ เช่น รอสั่งการ รอผล รอเข้าแฟ้ม\n□ Inspection = การตรวจสอบ เช่น ตรวจสอบความถูกต้อง\n\nวิธีทำ: แปลงทีละขั้นตอนเป็นสัญลักษณ์\n1 พิมพ์ต้นฉบับ = ○\n2 ตรวจสอบความถูกต้อง = □\n3 จัดรูปแบบ = ○\n4 ส่งไปแผนกถ่ายฟิล์ม = ⇨\n5 ถ่ายฟิล์ม = ○\n6 ตรวจสอบฟิล์ม = □\n7 รอตัดแต่งฟิล์ม = D\n8 ตัดแต่งฟิล์มทำเป็นเพลท = ○\n9 เก็บสำเนา = ▽\n10 นำฟิล์มถ่ายเป็นเพลท = ○\n11 ตรวจสอบเพลท = □\n12 ส่งไปแท่นพิมพ์ = ⇨\n13 เข้ากระบวนการพิมพ์ = ○\nรวมเป็น ○ □ ○ ⇨ ○ □ D ○ ▽ ○ □ ⇨ ○ ตรงกับข้อ 5\n\nเคล็ดลับ: ดูคำกริยา — ตรวจสอบ = □ / ส่งไป = ⇨ / รอ = D / เก็บ = ▽ / ลงมือทำอย่างอื่น = ○ และข้อไหนขึ้นต้นสลับตำแหน่ง □ กับ ⇨ ตั้งแต่ขั้นที่ 2 ก็ตัดทิ้งได้เลย"),
Q(8,"การจัดเรียงหน่วยดัชนีของชื่อ บริษัท เนสท์เล่ (ไทย) จำกัด ข้อใดถูกต้อง",
 ["เนสท์เล่ จำกัด (ไทย) (บริษัท)","เนสท์เล่ (บริษัทจำกัด) (ไทย)","เนสท์เล่ ไทย (บริษัทจำกัด)","เนสท์เล่ จำกัด (บริษัท) (ไทย)","เนสท์เล่ ไทย จำกัด (บริษัท)"],5,
 "อ้างอิง: ดูข้อ 5 ประกอบ\n\nหลักการ: ชื่อกิจการต้องแยกเป็น 'หน่วยดัชนี' แล้วเรียงตามลำดับ\n• คำบอกประเภทกิจการ (บริษัท, ห้างหุ้นส่วนจำกัด, ร้าน, โรงงาน ฯลฯ) ไม่นำมาเรียง ให้ย้ายไปไว้ในวงเล็บท้ายสุด\n• ส่วนที่เหลือเป็นชื่อจริง ให้เรียงตามลำดับที่ปรากฏ\n\nขั้นตอน: บริษัท เนสท์เล่ (ไทย) จำกัด\n1) ตัดคำว่า 'บริษัท' ไปไว้ท้ายสุดในวงเล็บ → (บริษัท)\n2) ที่เหลือคือ เนสท์เล่ / ไทย / จำกัด — คำว่า (ไทย) เป็นส่วนของชื่อ จึงนับเป็นหน่วยดัชนีหน่วยหนึ่ง (ไม่ต้องคงวงเล็บไว้)\n3) ได้ผลลัพธ์ = เนสท์เล่ ไทย จำกัด (บริษัท)\n\nวิเคราะห์ตัวเลือกที่ผิด: ข้อ 1 และ 4 สลับตำแหน่ง ไทย กับ จำกัด / ข้อ 2 และ 3 ย้ายคำว่า 'จำกัด' เข้าวงเล็บไปกับ 'บริษัท' ซึ่งไม่ตรงตามเฉลย (เปรียบเทียบกับข้อ 9: 'วสุธา จำกัด (บริษัท)')\n\nหมายเหตุ: ชีทแดง 1/64 มีโจทย์เดียวกันและเฉลยเขียนเป็น 'เนสท์เล่ (ไทย) จำกัด (บริษัท)' ลำดับหน่วยเหมือนกัน ต่างกันเพียงเขียนวงเล็บ (ไทย) หรือไม่"),
Q(9,"การจัดเก็บเอกสาร โดยเรียงตามลำดับตามระบบตัวอักษรที่เป็นชื่อกิจการ ข้อใดเรียงถูกต้อง\n1. บริษัท วสุธา จำกัด  2. ห้างหุ้นส่วนจำกัดวัชระภัณฑ์  3. โรงงานผลิตน้ำปลาวชิรการ\n4. สำนักงานบัญชีวิเชียร  5. วัดเวโรจน์วิหาร  6. ร้านวรางคณา",
 ["1, 6, 3, 5, 4, 2","1, 6, 2, 3, 5, 4","4, 1, 3, 6, 2, 5","3, 6, 1, 2, 4, 5","3, 6, 5, 4, 2, 1"],4,
 "อ้างอิง: ดูข้อ 5 ประกอบ\n\nหลักการ: ตัดคำบอกประเภทกิจการออกไปไว้ในวงเล็บท้ายชื่อ แล้วเรียงตามชื่อจริง\n\nแยกชื่อ:\n3) โรงงานผลิตน้ำปลา → วชิรการ (โรงงานผลิตน้ำปลา)\n6) ร้าน → วรางคณา (ร้าน)\n1) บริษัท → วสุธา จำกัด (บริษัท)\n2) ห้างหุ้นส่วนจำกัด → วัชระภัณฑ์ (ห้างหุ้นส่วนจำกัด)\n4) สำนักงานบัญชี → วิเชียร (สำนักงานบัญชี)\n5) วัด → เวโรจน์วิหาร (วัด)\n\nลำดับตามเฉลย: วชิรการ → วรางคณา → วสุธา → วัชระภัณฑ์ → วิเชียร → เวโรจน์วิหาร = ข้อ 3, 6, 1, 2, 4, 5\n\nสังเกต: ทุกชื่อขึ้นต้นด้วย 'ว' จึงเทียบตัวที่สอง — พยัญชนะ (ช → ร → ส) มาก่อนชื่อที่ตัวที่สองเป็นสระ (ั → ิ) และชื่อที่เขียนสระหน้า เ- (เวโรจน์) อยู่ท้ายสุด"),
Q(10,"การจัดทำรายงานที่ดี ควรทำอย่างไร",
 ["รายงานเรื่องที่ทำซ้ำกันอยู่เป็นประจำเพื่อเรียกร้องความสนใจจากผู้บริหารระดับสูง","จัดรายงานสรุปอยู่ในตอนท้ายของเล่ม","กลั่นกรองตามลำดับการบังคับบัญชา","บรรจุรายละเอียดมากที่สุดเพื่อเสนอต่อผู้บริหารระดับสูง","ควรให้ผู้บริหารสรุปข้อมูลด้วยตนเองทั้งหมด"],3,
 "อ้างอิง: หน้า 258–259\n\nหลักการ: รายงานที่ดีต้องออกแบบให้ 'ผู้บริหารที่มีเวลาน้อย' อ่านแล้วเข้าใจเร็ว โดย\n• จัดรายงานสรุปไว้ตอนเริ่มแรกของเล่ม (ไม่ใช่ท้ายเล่ม)\n• รายงานสถานการณ์ที่ไม่อาจแก้ไขได้ในระดับต่ำ เพื่อเรียกร้องความสนใจจากผู้บริหารระดับสูง\n• ผ่านการกลั่นกรองตามลำดับสายการบังคับบัญชา\n• ตัดรายละเอียดที่ไม่จำเป็นออก\n• สรุปข่าวสารข้อมูลพร้อมเสนอความคิดเห็น\n\nวิเคราะห์ตัวเลือก: ข้อ 1 ผิดเพราะรายงานเรื่องซ้ำ ๆ ประจำไม่ใช่เรื่องที่ต้องดึงความสนใจผู้บริหารระดับสูง (ต้องเป็นเรื่องที่ระดับล่างแก้ไม่ได้) / ข้อ 2 ผิดเพราะสรุปต้องอยู่ต้นเล่ม / ข้อ 4 ผิดเพราะต้องตัดรายละเอียดที่ไม่จำเป็น / ข้อ 5 ผิดเพราะผู้ทำรายงานต้องสรุปให้พร้อมเสนอความเห็น ไม่ใช่โยนให้ผู้บริหารสรุปเอง"),
Q(11,"หนังสือสัญญาซื้อขายที่ดินจัดเป็นเอกสารแบบใด",
 ["เอกสารไม่จำเป็น","เอกสารคุณค่าสูง","เอกสารสำคัญ","เอกสารที่มีประโยชน์","เอกสารจำเป็นต้องเก็บ"],2,
 " หลักการ: เอกสารคุณค่าสูง (Vital) คือเอกสารที่ต้องเก็บไว้ตลอดไป ในรายการตัวอย่างของเอกสารกลุ่มนี้ มี 'สัญญาซื้อขายที่ดิน' ระบุไว้ชัดเจน รวมทั้ง โฉนดที่ดิน ทะเบียนรถ พันธบัตร หุ้นกู้ งบแสดงฐานะการเงิน รายงานประจำปี สัญญากับสหภาพแรงงาน ข้อตกลงกับลูกจ้าง สัญญาว่าจ้างทำงาน\n\nทำไมไม่ใช่ 'เอกสารสำคัญ' (Important): Important เก็บประมาณ 5–6 ปี เช่น อัตราค่าจ้าง ส่วนสัญญาซื้อขายที่ดินเป็นหลักฐานสิทธิในทรัพย์สิน ต้องเก็บตลอดไป\n\nวิธีจำ: หลักฐานความเป็นเจ้าของ + สัญญา + งบการเงิน = Vital (เก็บตลอดไป)"),
Q(12,"ทุกข้อเป็นระบบของการจัดเก็บเอกสาร นอกจากข้อใด",
 ["ระบบรหัสบัตร","ระบบวันที่","ระบบตัวอักษร","ระบบตัวเลข","ระบบภูมิศาสตร์"],1,
 "อ้างอิง: หน้า 207\n\nหลักการ: ระบบการจัดเก็บเอกสารตามชีทนี้มี 4 ระบบ\n1. ระบบตัวอักษร (เรียงตามชื่อ A–Z / ก–ฮ)\n2. ระบบตัวเลข (เรียงตามเลขที่เอกสาร)\n3. ระบบภูมิศาสตร์ (เรียงตามสถานที่)\n4. ระบบวันที่ (เรียงตามเวลา)\n\nวิเคราะห์: 'ระบบรหัสบัตร' ไม่อยู่ใน 4 ระบบนี้\n\nวิธีจำ: อักษร – เลข – พื้นที่ – เวลา"),
Q(13,"สัญลักษณ์นี้ D อธิบายถึงอะไร",
 ["เซ็นอนุมัติใบสั่งขาย","ส่งใบสั่งขายไปยังพนักงานตั้งบิล","จดหมายที่อยู่ในกระบะหนังสือออก","สำเนาเก็บเข้าแฟ้ม","ผู้จัดการตรวจสอบเครดิตลูกค้า"],3,
 "อ้างอิง: ดูข้อ 7 ประกอบ\n\nสัญลักษณ์ D = Delay = การล่าช้า / การรอ\n\nโจทย์ข้อนี้ให้ 5 ตัวเลือก ซึ่งแต่ละข้อแทนสัญลักษณ์คนละตัว\n(1) เซ็นอนุมัติใบสั่งขาย = ลงมือทำ → ○ Operation\n(2) ส่งใบสั่งขายไปยังพนักงานตั้งบิล = เคลื่อนย้ายงาน → ⇨ Transportation\n(3) จดหมายที่อยู่ในกระบะหนังสือออก = นอนรอให้ถูกส่ง จึงเป็นการรอ → D Delay\n(4) สำเนาเก็บเข้าแฟ้ม = เก็บ → ▽ Storage\n(5) ผู้จัดการตรวจสอบเครดิตลูกค้า = ตรวจสอบ → □ Inspection\n\nเคล็ดลับ: ของที่ 'วางรอ / กองรอ / รออนุมัติ / รอผล' คือ D"),
Q(14,"แผนผังลำดับขั้นการปฏิบัติงาน ตามรายละเอียดที่แสดงนี้ตรงกับข้อใด\nประกาศรับสมัครพนักงานการเงิน – ส่งข้อมูลผู้สมัครไปแผนกการเงิน – ตรวจสอบหลักฐานการสมัคร – รอนัดวันสัมภาษณ์ – ผู้จัดการการเงินสัมภาษณ์ – เก็บข้อมูลเข้าแฟ้ม – ส่งหลักฐานไปแผนกทรัพยากรมนุษย์ – รอประกาศรายชื่อผู้ได้รับการบรรจุ",
 ["○ → D → □ → ○ → ⇨ → ○ → D → ▽","○ → □ → D → ⇨ → ○ → □ → ▽ → ⇨","○ → ⇨ → □ → D → ○ → ▽ → ⇨ → D","○ → ○ → D → ⇨ → ○ → □ → ○ → ▽","○ → ⇨ → □ → ⇨ → ○ → D → ○ → ▽"],3,
 "อ้างอิง: ดูข้อ 7 ประกอบ\n\nวิธีทำ: แปลงทีละขั้นตอนเป็นสัญลักษณ์ (○ ลงมือทำ / ⇨ ส่งต่อ / □ ตรวจสอบ / D รอ / ▽ เก็บ)\n1 ประกาศรับสมัครพนักงานการเงิน = ○\n2 ส่งข้อมูลผู้สมัครไปแผนกการเงิน = ⇨\n3 ตรวจสอบหลักฐานการสมัคร = □\n4 รอนัดวันสัมภาษณ์ = D\n5 ผู้จัดการการเงินสัมภาษณ์ = ○\n6 เก็บข้อมูลเข้าแฟ้ม = ▽\n7 ส่งหลักฐานไปแผนกทรัพยากรมนุษย์ = ⇨\n8 รอประกาศรายชื่อผู้ได้รับการบรรจุ = D\n\nรวมเป็น ○ ⇨ □ D ○ ▽ ⇨ D ตรงกับข้อ 3\n\nเคล็ดลับ: ขั้นที่ 2 คือ 'ส่ง...ไป' = ⇨ ตัดข้อ 1, 2, 4 ที่ขั้นที่ 2 ไม่ใช่ ⇨ ทิ้งทันที เหลือข้อ 3 กับ 5 แล้วดูขั้นที่ 4 (รอ = D) ข้อ 5 เป็น ⇨ จึงผิด"),
Q(15,"ในกรณีที่เป็นชื่อต่างประเทศ และจัดเก็บตามตัวอักษรภาษาไทย ข้อใดจัดเรียงถูกต้องตามหลักวิชา\n1. Ronny O. Washington  2. Andy B. Thomson  3. Banjamin P. Hansen\n4. Gateman W. Mowen  5. Linchard A. Sherwin",
 ["4, 3, 2, 5, 1","1, 3, 5, 2, 4","5, 2, 4, 1, 3","3, 4, 5, 2, 1","2, 5, 4, 1, 3"],3,
 "อ้างอิง: หน้า 212\n\nหลักการ: ชื่อชาวต่างประเทศที่เก็บในแฟ้มภาษาไทย\n• ให้เขียนชื่อนั้นเป็นภาษาไทย แล้วเรียงตามพจนานุกรมไทย\n• แต่รูปแบบชื่อยังเหมือนภาษาอังกฤษ คือ นามสกุล ตามด้วยชื่อต้น ชื่อกลาง แล้วยศ/คำนำหน้า\n\nแปลงเป็นไทย:\n1) Washington → วอชิงตัน รอนนี โอ.\n2) Thomson → ทอมสัน แอนดี บี.\n3) Hansen → แฮนเซน เบนจามิน พี.\n4) Mowen → โมเวน เกตแมน ดับเบิลยู.\n5) Sherwin → เชอร์วิน ลินชาร์ด เอ.\n\nเรียงตามพยัญชนะตัวแรกของนามสกุล (ไม่นับสระหน้า): ช (เชอร์วิน) → ท (ทอมสัน) → ม (โมเวน) → ว (วอชิงตัน) → ฮ (แฮนเซน) = ข้อ 5, 2, 4, 1, 3\n\nข้อนี้ใช้ต่อกับข้อ 34 (Senge)"),
Q(16,"ข้อใดกล่าวผิด",
 ["การปรับปรุงระบบงานเป็นคำที่ใช้สับเปลี่ยนแทนกันได้กับคำว่าการหาวิธีทำงานให้ง่ายขึ้น","การจัดระบบงานคือการปรับปรุงระบบงานที่มีอยู่ก่อนให้ดีขึ้น","ระบบคือชุดของระบบย่อยหลาย ๆ ระบบที่ประกอบด้วยหลาย ๆ วิธีปฏิบัติ และแต่ละวิธีปฏิบัติประกอบด้วยหลาย ๆ วิธีการ","การทำงานให้มีประสิทธิภาพ จำเป็นต้องหาวิธีทำงานให้ง่ายขึ้น","การปรับปรุงระบบงานคือการปรับวิธีปฏิบัติในการทำงาน"],2,
 "อ้างอิง: หน้า 146\n\nหลักการ: สองคำนี้ต่างกัน\n• การจัดระบบงาน = ออกแบบระบบงานใหม่ ซึ่งยังไม่เคยมีมาก่อน\n• การปรับปรุงระบบงาน = ปรับระบบงานที่มีอยู่ก่อนให้ดีขึ้น\n\nข้อ 2 สลับนิยามกัน จึงผิด\n\nส่วนข้ออื่นถูกต้อง:\n• ข้อ 1: 'ปรับปรุงระบบงาน' ใช้แทนกันได้กับ 'การหาวิธีทำงานให้ง่ายขึ้น' เพียงแต่ผู้ใช้ต่างกัน — ปรับปรุงระบบงานมักใช้กับผู้เชี่ยวชาญเฉพาะด้านที่เป็นฝ่ายที่ปรึกษา ส่วนการหาวิธีทำงานให้ง่ายขึ้น ผู้ปฏิบัติงานหรือหน่วยงานหลักทำเองกับงานที่ตนรับผิดชอบ\n• ข้อ 3: ลำดับชั้นของระบบ → ระบบ ประกอบด้วย ระบบย่อย → วิธีปฏิบัติ → วิธีการ (ใช้ต่อในข้อ 44, 65)\n• ข้อ 4, 5 เป็นหลักการที่ถูกต้อง\n\nข้อสอบมักออกเป็น 'ข้อใดกล่าวผิด' โดยสลับคำนิยามของ จัดระบบ (ใหม่) กับ ปรับปรุง (ของเดิม)"),
Q(17,"สำนักงานอัตโนมัติ (Office Automation) เรียกอีกอย่างว่าอะไร",
 ["สำนักงานส่วนหลัง","สำนักงานไร้กระดาษ","สำนักงานออนไลน์","สำนักงานส่วนหน้า","สำนักงานสำรองข้อมูล"],2,
 "อ้างอิง: หน้า 17–18\n\nหลักการ: สำนักงานอัตโนมัติ (OA) มีลักษณะสำคัญ 6 ข้อ\n1. นำคอมพิวเตอร์และระบบสื่อสารสมัยใหม่มาประยุกต์ใช้\n2. นำเทคโนโลยีขั้นสูงหรือเทคโนโลยีสมัยใหม่มาช่วยพัฒนางาน\n3. เก็บข้อมูลโดยใช้สื่ออิเล็กทรอนิกส์แทนกระดาษ\n4. อุปกรณ์ในสำนักงานต่อเชื่อมกันได้\n5. ใช้คอมพิวเตอร์เป็นอุปกรณ์หลัก\n6. ลดปริมาณการใช้ทรัพยากรมนุษย์ในการทำงานลง เพราะนำอุปกรณ์อัตโนมัติมาใช้แทน\n\nวิธีจำ: ข้อมูลอยู่ในอิเล็กทรอนิกส์แทนกระดาษ จึงได้ชื่อว่า 'ไร้กระดาษ' (ใช้ต่อในข้อ 42)"),
Q(18,"งานทางด้านการทดลองในสถานีอวกาศใช้เครื่องคอมพิวเตอร์ชนิดใด",
 ["Workstation","Minicomputer","Microcomputer","Mainframe","Supercomputer"],5,
 "อ้างอิง: หน้า 104\n\nหลักการ: ซูเปอร์คอมพิวเตอร์ (Supercomputer หรือ Supermainframe Computer) เป็นคอมพิวเตอร์อเนกประสงค์ที่ใหญ่ที่สุดและทำงานได้เร็วที่สุด นิยมใช้ในองค์การธุรกิจขนาดใหญ่และงานด้านวิทยาศาสตร์ที่ประมวลผลข้อมูลซับซ้อนและต้องการความแม่นยำสูง เช่น การพยากรณ์อากาศ การทดลองในสถานีอวกาศ และการสำรวจอวกาศ\n\nวิธีจำแยกจาก Mainframe (ข้อ 49): Super = วิทยาศาสตร์/อวกาศ/พยากรณ์อากาศ, Mainframe = ธนาคาร/ATM/สายการบิน/ประกันภัย\n(ข้อ 23 ถามซ้ำโดยเปลี่ยนเป็นพยากรณ์อากาศ)"),
Q(19,"การเก็บเอกสารตามระบบภูมิศาสตร์ควรใช้อะไรเป็นดัชนี",
 ["ชื่อผู้เขียน","ชื่อธุรกิจ","ชื่อเรื่อง","วันเดือนปี","ชื่อสถานที่"],5,
 "อ้างอิง: หน้า 210–211\n\nหลักการ: การเก็บตามระบบภูมิศาสตร์ แท้จริงคือ 'ระบบตัวอักษรที่ใช้ชื่อสถานที่เป็นดัชนี' โดยจัดเรียงเอกสารเป็นหมวดหมู่ตามอาณาเขตที่ตั้ง เช่น เริ่มจากภาค → จังหวัด → อำเภอ\n\nเหมาะกับธุรกิจที่มีสาขาอยู่ในสถานที่ต่าง ๆ เช่น ธุรกิจประเภทขนส่ง (ข้อ 54 ถามต่อว่าธุรกิจประกันภัยที่มีสาขากระจายหลายที่ ควรใช้ระบบนี้)\n\nวิธีจำ: ภูมิศาสตร์ = ที่ตั้ง/สถานที่ ไม่ใช่เวลา ไม่ใช่เลข ไม่ใช่ชื่อคน"),
Q(20,"เส้นที่ใช้ขีดคอลัมน์หัวข้อย่อยจากหัวข้อใหญ่ เรียกว่าอะไร",
 ["เส้นหนัก","เส้นคู่","เส้นไข่ปลา","เส้นประสม 3 เส้น","เส้นธรรมดา"],1,
 "อ้างอิง: หน้า 252–253\n\nหลักการ: เส้นที่ใช้ออกแบบฟอร์ม 5 ชนิด\n1. เส้นคู่ (Double Line) = ใช้เฉพาะหัวและท้ายแบบฟอร์มเท่านั้น (ข้อ 59 ถาม)\n2. เส้นหนัก (Heavy Line) = ใช้ขีดคั่นคอลัมน์หัวข้อย่อยจากหัวข้อใหญ่\n3. เส้นไข่ปลา (Dotted Line) = ใช้แบ่งช่องจำนวนเงิน เช่น บาท สตางค์ (ข้อ 53 ถาม)\n4. เส้นประสม 3 เส้น (Combination Line) = ใช้แบ่งช่องสำหรับการเปลี่ยนขึ้นหัวข้อใหม่\n5. เส้นธรรมดา (Standard Weight Line) = ใช้ทั่ว ๆ ไป\n\nวิธีจำ: คู่ = หัว/ท้าย, หนัก = กั้นหัวข้อย่อย, ไข่ปลา = เงิน, ประสม = เปลี่ยนหัวข้อใหม่, ธรรมดา = ทั่วไป"),
Q(21,"การจัดเก็บเอกสารไว้ในตู้ 5 ลิ้นชักนั้น สำหรับเอกสารประเภท Inactive File ควรเก็บไว้ในลิ้นชักใด",
 ["ลิ้นชักที่ 1 และ 2","ลิ้นชักที่ 2 และ 3","ลิ้นชักที่ 4 และ 5","ลิ้นชักที่ 3 และ 4","ลิ้นชักที่ 1 และ 5"],5,
 "อ้างอิง: หน้า 202–203\n\nหลักการ: ตู้ 5 ลิ้นชัก ลิ้นชักบนสุด (1) สูงเกินไป และล่างสุด (5) ต่ำเกินไป หยิบเอกสารไม่สะดวก\n• ลิ้นชัก 1 และ 5 → เก็บเอกสารที่ปฏิบัติเสร็จแล้ว (Inactive File) เพราะเปิดใช้น้อย\n• ลิ้นชัก 2, 3, 4 → เก็บเอกสารที่อยู่ระหว่างปฏิบัติงาน (Active File) เพราะหยิบใช้สะดวกกว่า\n\nวิธีคิด: ของที่ใช้บ่อยวางไว้ระดับมือ ของที่ไม่ค่อยใช้วางสูงสุด/ต่ำสุด (ดูต่อที่ข้อ 28)"),
Q(22,"เครื่องใช้สำนักงานชนิดใดเป็นระบบการสื่อสารด้วยภาพเพื่อรับ–ส่งเอกสาร โดยใช้เครื่องโทรศัพท์เป็นส่วนประกอบสำคัญ",
 ["โทรศัพท์","เครื่องคอมพิวเตอร์","โทรสาร","เครื่องพิมพ์ดีดไฟฟ้า","เครื่องถ่ายเอกสาร"],3,
 "อ้างอิง: หน้า 135–137\n\nหลักการ: เครื่องโทรสาร (Facsimile หรือ Fax) เป็นเครื่องใช้สำนักงานเพื่อรับ–ส่งเอกสาร หรือติดต่อสื่อสารข้อมูลโดยลายลักษณ์อักษร ทั้งตัวหนังสือและรูปภาพ หลักการทำงานคล้ายเครื่องถ่ายเอกสาร แต่สำเนาจะออกที่เครื่องโทรสารอีกเครื่องที่อยู่ห่างไกลกัน โดยเชื่อมกันด้วยระบบโทรศัพท์\n\nวิเคราะห์ตัวเลือก: โทรศัพท์ส่งได้แค่เสียง / ถ่ายเอกสารได้สำเนาที่เครื่องเดียวกัน ไม่ได้ส่งไปไกล / โทรสารคือตัวที่ 'ถ่ายเอกสารแล้วส่งทางสายโทรศัพท์'"),
Q(23,"งานทางด้านการพยากรณ์อากาศใช้เครื่องคอมพิวเตอร์ชนิดใด",
 ["Workstation","Minicomputer","Supercomputer","Mainframe","Microcomputer"],3,
 "อ้างอิง: ดูข้อ 18 ประกอบ\n\nงานพยากรณ์อากาศต้องประมวลผลข้อมูลมหาศาล ซับซ้อน และต้องการความแม่นยำสูง จึงใช้ซูเปอร์คอมพิวเตอร์ ซึ่งเป็นเครื่องคอมพิวเตอร์ที่ใหญ่และเร็วที่สุด (หน้า 104)\n\nจำคู่: พยากรณ์อากาศ / ทดลองในอวกาศ / สำรวจอวกาศ = Supercomputer, ส่วน ATM / ธนาคาร = Mainframe"),
Q(24,"การจัดเก็บเอกสารโดยการถ่ายภาพย่อส่วนข้อมูล เป็นการจัดเก็บเอกสารโดยระบบใด",
 ["ระบบวีดีโอเทปต์","ระบบอิเล็กทรอนิกส์ไฟล์","ระบบไมโครฟิช","ระบบอิเล็กทรอนิกส์เมล์","ระบบเทเลเท็กซ์"],3,
 "อ้างอิง: หน้า 126, 222\n\nหลักการ: ระบบไมโครฟิช หรือไมโครกราฟิก คือเทคโนโลยีถ่ายภาพย่อส่วนข้อมูลจากต้นฉบับลงบนไมโครฟิล์ม ในรูปวัสดุย่อส่วนที่เรียกว่า ไมโครฟอร์ม (มีหลายรูปแบบ) ซึ่งเล็กมากจนมองไม่เห็นด้วยตาเปล่า ต้องใช้เครื่องอ่าน\n\nวิธีจำ: คำสำคัญคือ 'ถ่ายภาพย่อส่วน' = ไมโคร (ย่อให้เล็ก) — ตัวเลือกอื่นเป็นวิดีโอ/อิเล็กทรอนิกส์ ไม่ใช่การย่อภาพ"),
Q(25,"เอกสารชนิดใดไม่เหมาะที่จะจัดเก็บโดยเรียงตามระบบตัวเลข",
 ["บัญชีลูกหนี้–เจ้าหนี้","เช็คธนาคาร","ใบกำกับสินค้า","บัตรลูกค้า","ใบสั่งซื้อ"],1,
 "อ้างอิง: หน้า 209, 211\n\nหลักการ: ระบบตัวเลข คือเรียงเอกสารตามลำดับเลขที่ เหมาะกับเอกสารที่มีหมายเลขกำกับและมีจำนวนมาก ๆ เช่น ใบสั่งซื้อ ใบส่งของ ใบกำกับสินค้า บัตรลูกค้า เช็คธนาคาร บันทึก และเรื่องโต้ตอบ\n\nส่วน 'บัญชีลูกหนี้–เจ้าหนี้' และ 'ใบเสร็จรับเงิน' นิยมจัดเก็บตามระบบวันที่ ไม่ใช่ระบบตัวเลข\n\nโจทย์เป็นแบบ 'ไม่เหมาะ' — เลือกตัวที่ไม่ใช่เอกสารมีเลขที่กำกับ"),
Q(26,"โปรแกรมสำเร็จรูปที่ใช้สร้างเอกสาร แก้ไขบันทึกเอกสาร คือ",
 ["ระบบการประมวลภาพ","ระบบจัดการข่าวสาร","ระบบประชุมทางไกล","ระบบการประมวลคำ","ระบบประมวลค่า"],4,
 " หลักการ: ระบบการประมวลคำ เป็นระบบที่ใช้สร้างเอกสาร แก้ไข ตัดต่อ และบันทึกเอกสารตามคำสั่งผู้ใช้ ช่วยให้พิมพ์จดหมาย รายงาน บันทึก และเอกสารต่าง ๆ ได้สะดวก โปรแกรมสำเร็จรูปที่นิยมได้แก่ Microsoft Word และ Word Perfect\n\nกับดัก: ข้อ 5 'ระบบประมวลค่า' ชื่อคล้ายกันมาก ให้สังเกตว่าเป็น 'ประมวลคำ' (Word) ไม่ใช่ 'ประมวลค่า' (ตัวเลข)"),
Q(27,"ข้อใดไม่ใช่เหตุผลในการพิจารณาเช่าเครื่องใช้สำนักงาน",
 ["มีการเปลี่ยนแปลงการทำงานบ่อย","เครื่องใช้มีราคาสูง","มีการเปลี่ยนแปลงทางเทคนิคอย่างรวดเร็ว","ต้องการใช้ในระยะยาว","เหมาะสำหรับความต้องการเป็นครั้งคราว"],4,
 "อ้างอิง: หน้า 96–97\n\nหลักการ: เหตุผลที่ควรพิจารณา 'เช่า' เครื่องใช้สำนักงาน มี 7 ข้อ\n1. เครื่องใช้มีการเปลี่ยนแปลงทางเทคนิคใหม่ ๆ อย่างรวดเร็ว\n2. เครื่องใช้มีราคาสูง\n3. ผู้ขายให้ความสะดวกในการเช่ามากกว่าการขาย\n4. ผู้ให้เช่าให้ความสะดวกในการให้บริการ\n5. มีการเปลี่ยนแปลงวิธีการทำงานบ่อย ๆ\n6. ต้นทุนต่ำกว่าการซื้อ ถ้าเป็นการเช่าระยะสั้น\n7. เหมาะสำหรับเครื่องใช้ที่มีความต้องการเป็นครั้งคราวตามความจำเป็น\n\nเทียบตัวเลือก: ข้อ 1 = เหตุผลที่ 5 / ข้อ 2 = เหตุผลที่ 2 / ข้อ 3 = เหตุผลที่ 1 / ข้อ 5 = เหตุผลที่ 7\nส่วนข้อ 4 'ต้องการใช้ระยะยาว' ไม่อยู่ในรายการ (ยิ่งใช้ยาว การเช่ายิ่งแพงกว่าการซื้อ — ข้อ 6 ระบุว่าเช่าคุ้มเมื่อเป็น 'ระยะสั้น')\n\nโจทย์เป็นแบบ 'ไม่ใช่' → เลือกที่ขัดกับแนวคิดการเช่า"),
Q(28,"Active File หมายถึงอะไร",
 ["เอกสารที่ปฏิบัติเสร็จสิ้นแล้ว","เอกสารที่ใช้อ้างอิงน้อย","เอกสารที่มีค่าหรือสำคัญ","เอกสารที่อยู่ในระหว่างปฏิบัติงาน","เอกสารที่ควรทำลาย"],4,
 "อ้างอิง: หน้า 196\n\nหลักการ: เอกสารโดยทั่วไปแบ่งตามสถานะการปฏิบัติงานเป็น 3 ประเภท\n1. เอกสารที่อยู่ในระหว่างปฏิบัติงาน = Active File  (ใช้อยู่ จึงเก็บไว้ใกล้มือ — ลิ้นชัก 2, 3, 4 ตามข้อ 21)\n2. เอกสารที่ปฏิบัติเสร็จสิ้นแล้ว = Inactive File (เก็บลิ้นชัก 1 และ 5)\n3. เอกสารที่ควรทำลาย = Destruction\n\nเทียบตัวเลือก: ข้อ 1 = Inactive / ข้อ 5 = Destruction / ข้อ 2 และ 3 ไม่ใช่นิยามของ Active File\n\nวิธีจำ: Active = กำลังใช้งานอยู่ (active = กระตือรือร้น)"),
Q(29,"การจัดเรียงลำดับตามระบบตัวอักษรที่เป็นชื่อเรื่อง ข้อใดถูกต้องตามหลักวิชา\n1. ใบเสร็จรับเงิน  2. ใบสำคัญจ่าย  3. ใบสัญญาสั่งซื้อ\n4. ใบสั่งสินค้า  5. ใบสำรวจยอดขาย",
 ["2, 3, 1, 5, 4","3, 5, 4, 2, 1","4, 3, 2, 5, 1","3, 4, 5, 2, 1","4, 2, 3, 1, 5"],3,
 "อ้างอิง: ดูข้อ 5 ประกอบ\n\nลำดับตามเฉลย: ใบสั่งสินค้า → ใบสัญญาสั่งซื้อ → ใบสำคัญจ่าย → ใบสำรวจยอดขาย → ใบเสร็จรับเงิน\n\nวิธีเรียง: ทุกรายการขึ้นต้นด้วยคำว่า 'ใบ' เหมือนกัน จึงเทียบคำถัดไป\n• สั่ง (ใบสั่งสินค้า) มาก่อน สัญ (ใบสัญญา...) เพราะตัวถัดไป ง มาก่อน ญ ในลำดับ ก–ฮ\n• สัญ... มาก่อน สำ... (สำคัญ, สำรวจ)\n• สำคัญ มาก่อน สำรวจ เพราะ ค มาก่อน ร\n• ใบเสร็จรับเงินขึ้นต้นด้วยสระหน้า เ- จึงอยู่ท้ายสุดตามเฉลย (เหมือนข้อ 6 และข้อ 9)\n\nถ้าตัวเลือกใดไม่เริ่มด้วย 4 (ใบสั่งสินค้า) ตัดทิ้งได้ทันที เหลือข้อ 3 กับ 5 แล้วดูตัวที่สอง"),
Q(30,"ข้อเสนอแนะเพื่อให้การเคลื่อนไหวมีประสิทธิภาพ ข้อใดกล่าวผิด",
 ["การเคลื่อนไหวให้สั้นที่สุดเท่าที่จะทำได้","เคลื่อนมือทั้งสองในขณะเดียวกัน แต่ไปในทิศทางตรงกันข้าม","เคลื่อนไหวโดยการก้าวเท้าสั้น ๆ","การเริ่มต้นและสิ้นสุดการเคลื่อนไหวของช่วงแขนในเวลาเดียวกัน","การเคลื่อนไหวเป็นลักษณะโค้ง"],3,
 "อ้างอิง: หน้า 167–170\n\nหลักการเคลื่อนไหวอย่างมีประสิทธิภาพ (ใช้แขน/มือเป็นหลัก)\n1. ใช้มือทั้งสองข้างทำงาน (ถ้าเป็นไปได้) เพื่อเพิ่มผลผลิต\n2. เคลื่อนมือทั้งสองพร้อมกัน แต่ไปในทิศทางตรงกันข้าม\n3. เริ่มต้นและสิ้นสุดการเคลื่อนไหวของแขนหรือมือสองข้างในเวลาเดียวกัน\n4. เคลื่อนมือและช่วงแขนให้นุ่มนวลสม่ำเสมอ (ลักษณะโค้ง)\n5. ให้การเคลื่อนไหวสั้นที่สุดเท่าที่จะทำได้\n6. ให้การเคลื่อนไหวเป็นไปตามธรรมชาติมากที่สุด\n\nเทียบตัวเลือก: ข้อ 1 = หลักข้อ 5 / ข้อ 2 = หลักข้อ 2 / ข้อ 4 = หลักข้อ 3 / ข้อ 5 = หลักข้อ 4\nส่วนข้อ 3 'ก้าวเท้าสั้น ๆ' ไม่อยู่ในหลักการ (หลักการพูดถึงมือและแขน ไม่ใช่เท้า)\n\nโจทย์เป็นแบบ 'กล่าวผิด' ให้หาข้อที่ไม่ตรงกับ 6 หลักข้างบน"),
Q(31,"ข้อใดกล่าวไม่ถูกต้องเกี่ยวกับ \"สำนักงาน\"",
 ["เป็นศูนย์กลางในการรวบรวมงานเอกสารขององค์การ","เป็นสื่อกลางในการติดต่อประสานงานกับหน่วยงานอื่น","เป็นหน่วยงานที่ให้บริการด้านข้อมูลข่าวสารแก่หน่วยงานอื่น","เป็นหน่วยงานที่ตั้งอยู่บริเวณกึ่งกลางขององค์การ","เป็นแหล่งรวมข้อเท็จจริงเพื่อใช้ปฏิบัติงาน"],4,
 "อ้างอิง: หน้า 4–5\n\nหลักการ: สำนักงาน (Office) คือ สถานที่ที่ใช้ดำเนินงานข่าวสารข้อมูลหรืองานหนังสือขององค์การ เป็นศูนย์กลางรวบรวมงานเอกสารหรือข้อเท็จจริงเพื่อใช้ปฏิบัติงาน บริการด้านข้อมูลข่าวสาร และติดต่อประสานงานกับหน่วยงานอื่น จึงเปรียบสำนักงานเหมือน 'ศูนย์ประสาทหรือสมองของมนุษย์'\n\nวิเคราะห์: ข้อ 1, 2, 3, 5 ตรงกับนิยามทุกคำ ส่วนข้อ 4 บอกว่า 'ตั้งอยู่บริเวณกึ่งกลางองค์การ' เป็นเรื่องตำแหน่งที่ตั้งทางกายภาพ ซึ่งนิยามไม่ได้พูดถึง — สำนักงานเป็นศูนย์กลางด้านข้อมูล ไม่ได้แปลว่าต้องตั้งอยู่กลางองค์การ\n\nกับดัก: คำว่า 'ศูนย์กลาง' ในนิยามหมายถึงศูนย์กลาง 'การรวบรวมข้อมูล' ไม่ใช่ศูนย์กลาง 'ที่ตั้ง'"),
Q(32,"การทำรหัส หมายถึง",
 ["การนำเอกสารเข้าเก็บในแฟ้มที่เตรียมไว้","การแสดงความเกี่ยวข้องระหว่างเอกสารในแฟ้มกับเอกสารอื่น","การเลือกหน่วยที่จะเก็บโดยใช้ชื่อเป็นชื่อแฟ้มเพื่อช่วยในการค้นหา","การทำเครื่องหมายบนเอกสารที่จะเก็บเพื่อบอกแหล่งที่จะนำไปเก็บ","การแยกเอกสารที่ต้องการโอนไปไว้กับเอกสารอื่น"],4,
 "อ้างอิง: ดูข้อ 2 ประกอบ\n\nหลักการ: การทำรหัส (Coding) หมายถึง การทำเครื่องหมายบนเอกสารที่จะเก็บ โดยใช้ดินสอสีขีดเส้นใต้หรือทำวงล้อมรอบชื่อดัชนี เพื่อบอกแหล่งที่เอกสารจะนำไปเก็บ\n\nเทียบกับข้อ 2: ข้อ 3 ในข้อนี้คือคำนิยามของ 'การทำดัชนี' (ข้อ 2 ถามและตอบข้อ 3) ซึ่งเป็นกับดักเดียวกัน\n\nวิธีจำ: ดัชนี = เลือกชื่อ / รหัส = ทำเครื่องหมาย"),
Q(33,"เครื่องโทรสาร เป็นเครื่องใช้สำนักงานประเภทใด",
 ["เครื่องใช้ติดต่อสื่อสารข้อมูลโดยลายลักษณ์อักษร","เครื่องใช้ติดต่อสื่อสารข้อมูลด้วยวาจา","เครื่องประมวลผลข้อมูล","เครื่องบันทึกและจัดเก็บข้อมูล","ไม่มีข้อใดถูก"],1,
 "อ้างอิง: ดูข้อ 22 ประกอบ\n\nหลักการ: เครื่องโทรสารใช้ติดต่อสื่อสารข้อมูล 'โดยลายลักษณ์อักษร' ทั้งตัวหนังสือและรูปภาพ ส่งผ่านระบบโทรศัพท์ไปยังเครื่องปลายทาง\n\nวิเคราะห์: ข้อ 2 ติดต่อด้วยวาจา คือโทรศัพท์ ไม่ใช่โทรสาร / ข้อ 3 และ 4 เป็นหน้าที่ของคอมพิวเตอร์และอุปกรณ์จัดเก็บ\n\nวิธีจำ: โทรศัพท์ = เสียง (วาจา), โทรสาร = เอกสาร (ลายลักษณ์อักษร)",false,true),
Q(34,"การจัดเรียงชื่อชาวต่างประเทศโดยเก็บในแฟ้มภาษาไทยของ Peter M. Senge ข้อใดถูกต้อง",
 ["เอ็ม. ปีเตอร์ เซงเก้","เซงเก้ ปีเตอร์ เอ็ม.","เซงเก้ เอ็ม. ปีเตอร์","ปีเตอร์ เซงเก้ เอ็ม.","ปีเตอร์ เอ็ม. เซงเก้"],2,
 "อ้างอิง: ดูข้อ 15 ประกอบ\n\nหลักการ: ชื่อชาวต่างประเทศในแฟ้มภาษาไทย ให้เขียนเป็นภาษาไทย แต่รูปแบบเหมือนภาษาอังกฤษ คือ ขึ้นด้วยนามสกุล → ชื่อต้น → ชื่อกลาง (และยศ/คำนำหน้าท้ายสุด)\n\nPeter M. Senge → นามสกุล Senge = เซงเก้, ชื่อต้น Peter = ปีเตอร์, ชื่อกลาง M. = เอ็ม. → เซงเก้ ปีเตอร์ เอ็ม.\n\nเทียบข้อ 15: Washington Ronny O. → วอชิงตัน รอนนี โอ. รูปแบบเดียวกัน"),
Q(35,"เมื่อเห็นสีน้ำเงินสด ใช้สีเป็นสัญญาณบอกถึงอะไร",
 ["ใช้บอกถึงความปลอดภัย","ใช้บอกเตือนว่าเครื่องจักรกำลังอยู่ในระหว่างซ่อมแซม","ใช้บอกอันตรายจากแสงเอกซเรย์","ใช้บอกสัญญาณอันตราย","ใช้บอกทางจราจร"],2,
 "อ้างอิง: หน้า 79\n\nกฎข้อบังคับเกี่ยวกับการใช้สีเพื่อความปลอดภัย 6 สี\n1. สีแดงสด = เครื่องมือดับเพลิง สัญญาณอันตราย และสัญญาณให้หยุด\n2. สีส้ม = เตือนให้ระวังอันตรายที่อาจสะดุด ตก หรือหกล้ม\n3. สีเขียวสด = ความปลอดภัย และใช้เป็นสีของเครื่องมือปฐมพยาบาล\n4. สีน้ำเงินสด = เตือนให้รู้ว่าเครื่องจักรกำลังอยู่ในระหว่างการซ่อมแซม\n5. สีม่วงแดงสด = อันตรายจากแสงเอกซเรย์\n6. สีขาวดำ = บอกทางจราจร และเป็นเครื่องหมายของพนักงานแม่บ้าน\n\nวิธีจำ: น้ำเงิน = ซ่อมเครื่อง (ห้ามเปิดเครื่องขณะซ่อม) / เขียว = ปลอดภัย / แดง = หยุดหรืออันตราย / ม่วงแดง = เอกซเรย์ (ข้อ 45 และ 79 ใช้ตัวเลือกชุดเดียวกัน)"),
Q(36,"ข้อใดไม่ใช่ลักษณะของการออกแบบแบบฟอร์มที่ดี",
 ["กำหนดชื่อแบบฟอร์มให้ตรงกับจุดมุ่งหมาย","บรรจุข้อมูลให้มีปริมาณมากที่สุด","จัดเรียงลำดับรายการโดยใส่ตัวเลขกำกับ","จัดหมวดหมู่ของข้อมูลตามลำดับ","คำสั่งหรือข้อแนะนำควรมีให้น้อยที่สุด"],2,
 "อ้างอิง: หน้า 237\n\nหลักการ: แบบฟอร์มที่ดีต้องออกแบบให้ 'ง่ายต่อการกรอก' และ 'ง่ายต่อการนำข้อมูลไปใช้' คือเป็นแบบฟอร์มที่ง่าย ไม่ยุ่งยาก และบรรจุเฉพาะข้อมูลที่จำเป็นทั้งด้านปริมาณและคุณภาพ\n\nวิเคราะห์: ข้อ 2 'บรรจุข้อมูลให้มากที่สุด' ขัดกับหลักการ เพราะแบบฟอร์มที่ยัดข้อมูลมากไปจะกรอกยาก ส่วนข้อ 1, 3, 4, 5 เป็นลักษณะที่ดีของแบบฟอร์ม (ชื่อชัด เรียงเลขกำกับ จัดหมวดหมู่ คำสั่งสั้น)\n\nคำสำคัญ: 'เฉพาะที่จำเป็น' ไม่ใช่ 'มากที่สุด'"),
Q(37,"☐ (Ballot Box) ในแบบฟอร์มมีไว้เพื่ออะไร",
 ["ให้เกิดความสวยงาม","เพื่อต้องการเน้นข้อความ","ช่วยจำกัดเนื้อที่ให้อยู่ในขอบเขต","เพื่อประหยัดเนื้อที่","เพื่อนำหน้าข้อความและช่วยให้การตัดสินใจเร็วขึ้น"],5,
 "อ้างอิง: หน้า 242\n\nหลักการ: ช่อง ☐ (Ballot Box) ใช้นำหน้าข้อความ กำหนดไว้ให้ผู้กรอกเลือกตอบตามที่เห็นชอบ ผู้ออกแบบแบบฟอร์มคาดการณ์ไว้แล้วว่าผู้กรอกอาจจะกรอกข้อมูลอย่างไรบ้าง ดังนั้นวิธีนี้ช่วยให้ผู้กรอกตัดสินใจได้เร็วขึ้น ประหยัดเวลา เพราะเพียงแต่ทำเครื่องหมาย ✓ หรือ × ในช่องหน้าข้อความที่เลือก และยังง่ายต่อการตรวจสอบและนำข้อมูลไปใช้ด้วย\n\nวิธีจำ: ☐ = ติ๊กเลือก ทำให้ตอบเร็ว"),
Q(38,"ส่วนใดของจดหมายมีความสำคัญที่สุด",
 ["ที่อยู่","ชื่อผู้เขียน","วันที่","คำขึ้นต้น","คำลงท้าย"],2,
 " หลักการ: จดหมายโดยทั่วไปประกอบด้วย ที่อยู่ของผู้เขียน, วันเดือนปีที่เขียน, คำขึ้นต้น, เนื้อหา, คำลงท้าย และ ชื่อผู้เขียน ส่วนที่สำคัญที่สุดรองลงมาจากเนื้อหาคือ 'ชื่อผู้เขียน' เพราะเป็นส่วนที่ทำให้ผู้รับทราบว่าใครเป็นเจ้าของจดหมาย หรือส่งมาจากใคร\n\nเนื่องจาก 'เนื้อหา' ไม่ได้อยู่ในตัวเลือก ข้อที่สำคัญที่สุดจึงเป็นชื่อผู้เขียน\n\nวิธีจำ: จดหมายไม่มีชื่อผู้เขียน = ไม่รู้ว่าใครส่ง"),
Q(39,"การจัดเก็บเอกสารตามตัวอักษรภาษาอังกฤษ ชื่อบุคคลของ Prof. Dr. Philip G. Kotler คือ",
 ["(Prof.) Kotler G. Philip (Dr.)","Philip Kotler G. (Prof. Dr.)","Prof. Philip Kotler G. (Dr.)","Kotler Philip G. (Dr.) Prof.","Kotler Philip G. (Prof. Dr.)"],5,
 "อ้างอิง: หน้า 212–213\n\nหลักการจัดเรียงเอกสารภาษาอังกฤษ\n1. ใช้นามสกุลขึ้นต้น ตามด้วยชื่อต้น ชื่อกลาง และยศหรือคำนำหน้านาม (ยศ/คำนำหน้าอยู่ในวงเล็บท้ายสุด)\n2. เรียงพวกที่มีชื่อโดด ๆ ไว้ก่อนพวกที่มีหลายชื่อ\n3. คำประสมถือปฏิบัติเช่นเดียวกับคำเดี่ยว\n4. ถ้าเป็นตัวย่อ ให้จัดเรียงเหมือนตัวเต็มตามที่สะกด\n\nProf. Dr. Philip G. Kotler → นามสกุล Kotler / ชื่อต้น Philip / ชื่อกลาง G. / ยศ (Prof. Dr.) = Kotler Philip G. (Prof. Dr.)\n\nวิธีจำ: นามสกุล – ชื่อต้น – ชื่อกลาง – (ยศ) ถ้ายศอยู่หน้าชื่อหรือไม่อยู่ในวงเล็บ ข้อนั้นผิด"),
Q(40,"วงจรชีวิตของเอกสารได้แก่ข้อใด",
 ["การสร้าง – การนำไปใช้ – การอ้างอิง – การทำลาย – การจัดเก็บ","การสร้าง – การนำไปใช้ – การจัดเก็บ – การอ้างอิง – การทำลาย","การสร้าง – การนำไปใช้ – การอ้างอิง – การจัดเก็บ – การทำลาย","การสร้าง – การอ้างอิง – การนำไปใช้ – การจัดเก็บ – การทำลาย","การสร้าง – การอ้างอิง – การจัดเก็บ – การนำไปใช้ – การทำลาย"],2,
 "อ้างอิง: หน้า 192\n\nวงจรชีวิตของเอกสาร (The Records Cycle) มี 5 ขั้นตอน\n1. การสร้างหรือการผลิต (Creation)\n2. การนำไปใช้ (Utilization)\n3. การจัดเก็บ (Storage)\n4. การอ้างอิงหรือการนำกลับมาใช้อีก (Retrieval)\n5. การทำลาย (Disposition)\n\nวิธีจำ: สร้าง → ใช้ → เก็บ → ค้น/อ้างอิง → ทิ้ง (เหมือนชีวิตของสิ่งของ เกิด ใช้งาน เก็บ หยิบมาใช้ซ้ำ แล้วทิ้ง)\nตัวเลือก 1 สลับ 'ทำลาย' ไปก่อน 'จัดเก็บ' / ตัวเลือก 3 สลับ 'จัดเก็บ' กับ 'อ้างอิง' / 4 และ 5 เอา 'อ้างอิง' ขึ้นก่อนการนำไปใช้ ซึ่งไม่สมเหตุผล (ต้องมีการใช้งานและเก็บก่อนถึงจะอ้างอิงได้)"),
Q(41,"การบริหารเอกสารตามแนวคิดของ Weber สรุปได้ว่า R = C และ Re  Re หมายถึง",
 ["Relation","Reference","Report","Reengineering","Remember"],2,
 "อ้างอิง: หน้า 189–190\n\nหลักการ: Weber ถือว่าการบริหารเอกสารอย่างมีประสิทธิภาพต้องมีการบันทึกข่าวสารข้อมูลไว้เป็นหลักฐาน เพราะ\n• Record (R) = เอกสาร เป็นเครื่องมือในการติดต่อสื่อสาร (Communication – C)\n• และยังเป็นสิ่งที่นำมาใช้อ้างอิงได้ (Reference – Re)\nจึงสรุปว่า R = C หรือ Re (เอกสาร = การสื่อสาร และการอ้างอิง)\n\nวิธีจำ: Record = Communication + Reference"),
Q(42,"ลักษณะสำคัญของสำนักงานอัตโนมัติ ยกเว้นข้อใด",
 ["ใช้เทคโนโลยีสมัยใหม่เข้ามาช่วยพัฒนางาน","ใช้กระดาษเป็นสื่อกลางในการเก็บข้อมูล","อุปกรณ์ในสำนักงานต่อเชื่อมกันได้","ใช้คอมพิวเตอร์เป็นอุปกรณ์หลัก","ลดปริมาณการใช้ทรัพยากรมนุษย์ในการทำงาน"],2,
 "อ้างอิง: ดูข้อ 17 ประกอบ\n\nสำนักงานอัตโนมัติ = สำนักงานไร้กระดาษ ลักษณะสำคัญ: ใช้คอมพิวเตอร์/เทคโนโลยีสมัยใหม่ / เก็บข้อมูลด้วยสื่ออิเล็กทรอนิกส์แทนกระดาษ / อุปกรณ์ต่อเชื่อมกันได้ / ใช้คอมพิวเตอร์เป็นอุปกรณ์หลัก / ลดการใช้ทรัพยากรมนุษย์\n\nข้อ 2 'ใช้กระดาษเป็นสื่อกลางในการเก็บข้อมูล' ตรงข้ามกับหลักการ จึงเป็นข้อยกเว้น\n\nจำชื่อเล่นของ OA ไว้ 'ไร้กระดาษ' ตัวเลือกไหนพูดถึงการใช้กระดาษเป็นหลัก = ผิด"),
Q(43,"ลักษณะของงานสำนักงาน ข้อใดกล่าวไม่ถูกต้อง",
 ["ขนาดของงานในสำนักงานควบคุมไม่ได้ ขึ้นอยู่กับปัจจัยภายนอกองค์การ","เป็นงานให้บริการแก่หน่วยงานต่าง ๆ","งานสำนักงานเป็นงานเกี่ยวกับการขีดเขียนหนังสือ","งานสำนักงานมีส่วนทางตรงในการสร้างกำไรให้ธุรกิจ","งานสำนักงานเป็นงานข่าวสารข้อมูลขององค์การ"],4,
 "อ้างอิง: หน้า 4–5\n\nลักษณะสำคัญของงานสำนักงาน\n1. เป็นงานให้บริการแก่หน่วยงานต่าง ๆ\n2. ขนาดของงานขึ้นอยู่กับปัจจัยภายนอกองค์การ ซึ่งไม่อาจควบคุมได้\n3. คำนวณหากำไรโดยตรงไม่ได้ แต่มีส่วนร่วมทางอ้อมในการทำกำไรให้ธุรกิจ\n4. เป็นงานเกี่ยวกับการขีดเขียนหนังสือหรืองานข่าวสารข้อมูลขององค์การ\n5. เป็นงานส่วนใหญ่ของงานทั้งหมดในองค์การบางประเภท\n\nเทียบตัวเลือก: ข้อ 1 = ลักษณะ 2 / ข้อ 2 = ลักษณะ 1 / ข้อ 3 = ลักษณะ 4 / ข้อ 5 = ลักษณะ 4\nข้อ 4 ผิด เพราะงานสำนักงานมีส่วนร่วม 'ทางอ้อม' ในการสร้างกำไร ไม่ใช่ทางตรง (ไม่เหมือนฝ่ายผลิตหรือขาย)\n\nคำสำคัญ: ทางอ้อม vs ทางตรง"),
Q(44,"การจัดระเบียบความยุ่งยาก ความซับซ้อน เกี่ยวกับวิธีปฏิบัติที่กำหนดขึ้น โดยมีจุดมุ่งหมายที่จะให้กิจกรรมหลักขององค์การสำเร็จลุล่วงไปด้วยดี หมายถึงอะไร",
 ["ดำเนินการ","ระบบ","วิธีปฏิบัติ","กระบวนการ","วิธีการ"],2,
 "อ้างอิง: หน้า 143\n\nหลักการ: ระบบ (System) หมายถึง การจัดระเบียบความยุ่งยากซับซ้อนเกี่ยวกับวิธีปฏิบัติที่กำหนดขึ้น โดยมีจุดมุ่งหมายที่จะให้กิจกรรมหลักขององค์การสำเร็จลุล่วงไปด้วยดี นอกจากนี้ยังหมายถึง ชุดของระบบย่อยหลาย ๆ ระบบ ที่ประกอบด้วยวิธีปฏิบัติต่าง ๆ หลายแบบ และแต่ละวิธีปฏิบัติประกอบด้วยหลาย ๆ วิธีการ\n\nลำดับชั้น: ระบบ → ระบบย่อย → วิธีปฏิบัติ → วิธีการ (ใหญ่ไปเล็ก)\n\nถ้าโจทย์พูดถึง 'จัดระเบียบ... ให้กิจกรรมหลักสำเร็จ' ตอบ 'ระบบ' (ข้อ 65, 87 ใช้ต่อ)"),
Q(45,"เมื่อเห็นสีเขียวสด ใช้สีเป็นสัญญาณบอกถึงอะไร",
 ["ใช้บอกถึงความปลอดภัย","ใช้บอกเตือนว่าเครื่องจักรกำลังอยู่ในระหว่างซ่อมแซม","ใช้บอกอันตรายจากแสงเอกซเรย์","ใช้บอกสัญญาณอันตราย","ใช้บอกทางจราจร"],1,
 "อ้างอิง: ดูข้อ 35 ประกอบ\n\nสีเขียวสด ใช้บอกถึงความปลอดภัย และใช้เป็นสีของเครื่องมือปฐมพยาบาล\n\nเทียบตัวเลือก: ข้อ 2 = น้ำเงินสด / ข้อ 3 = ม่วงแดงสด / ข้อ 4 = แดงสด (และส้มเตือนให้ระวังการสะดุดหรือตก) / ข้อ 5 = ขาวดำ\n\nวิธีจำ: เขียว = ปลอดภัย (เหมือนไฟเขียว)"),
Q(46,"การเรียงแฟ้มตามระบบตัวอักษรที่เป็นชื่อเรื่อง ข้อใดเรียงถูกต้อง\n1. งานบัญชี  2. งานตลาด  3. งานพัสดุ\n4. งานทะเบียน  5. งานสำนักงาน  6. งานวิจัยและพัฒนา",
 ["2, 1, 3, 5, 6, 4","2, 4, 1, 3, 6, 5","1, 2, 5, 3, 6, 4","3, 4, 5, 1, 6, 2","2, 3, 5, 4, 6, 1"],2,
 "อ้างอิง: ดูข้อ 5 ประกอบ\n\nลำดับที่ถูก: งานตลาด → งานทะเบียน → งานบัญชี → งานพัสดุ → งานวิจัยและพัฒนา → งานสำนักงาน\n\nวิธีเรียง: ทุกรายการขึ้นต้นด้วย 'งาน' เหมือนกัน จึงเทียบพยัญชนะตัวถัดไปตามลำดับ ก–ฮ\nต (ตลาด) → ท (ทะเบียน) → บ (บัญชี) → พ (พัสดุ) → ว (วิจัย) → ส (สำนักงาน)\n\nวิธีจำลำดับพยัญชนะที่ใช้บ่อย: ต ท น บ ป ผ พ ฟ ม ย ร ล ว ส ห อ ฮ"),
Q(47,"จุดประสงค์หลักของการจัดแผนผังสำนักงานคือข้อใด",
 ["จัดให้ห้องดูกว้างขวาง","จัดให้ผู้มาติดต่อเกิดความประทับใจ","จัดให้สายทางเดินของงานมีประสิทธิภาพ","จัดให้พนักงานมีความสะดวกสบาย","จัดให้ห้องมีความยืดหยุ่นใช้ได้เต็มพื้นที่"],3,
 "อ้างอิง: หน้า 58\n\nหลักการ: การจัดแผนผังสำนักงาน (Office Layout) หมายถึง การวางแผนจัดระเบียบปัจจัยต่าง ๆ ที่ช่วยให้ 'สายทางเดินของงาน' (Work flow) เกิดความคล่องตัว โดยคำนึงถึงประโยชน์ใช้สอยและความสะดวกของพนักงาน ทั้งนี้จุดประสงค์หลักคือจัดให้สายทางเดินของงานมีประสิทธิภาพ\n\nข้อ 4 ฟังดูดี แต่ 'ความสะดวกของพนักงาน' เป็นสิ่งที่ต้องคำนึงถึงประกอบ ไม่ใช่จุดประสงค์หลัก\n\nคำสำคัญ: สายทางเดินของงาน (งานต้องไหลคล่อง)"),
Q(48,"แผนผังลำดับขั้นการปฏิบัติงานที่แสดงนี้ตรงกับข้อใด   ○ → D → ⇨ → ○ → ▽ → ○ → □ → ○",
 ["พิมพ์ใบสั่งของ – ตรวจความถูกต้อง – ออกเลขที่ – เก็บสำเนา – สั่งของ – เพิ่มข้อมูล – รออนุมัติ – ส่งงานจัดซื้อ","พิมพ์ใบสั่งของ – รออนุมัติ – ส่งงานจัดซื้อ – ออกเลขที่ – เก็บสำเนา – สั่งของ – ตรวจความถูกต้อง – เพิ่มข้อมูล","พิมพ์ใบสั่งของ – ตรวจความถูกต้อง – เพิ่มข้อมูล – รออนุมัติ – ส่งงานจัดซื้อ – ออกเลขที่ – เก็บสำเนา – สั่งของ","พิมพ์ใบสั่งของ – ส่งงานจัดซื้อ – ออกเลขที่ – เก็บสำเนา – สั่งของ – ตรวจความถูกต้อง – เพิ่มข้อมูล – รออนุมัติ","พิมพ์ใบสั่งของ – เพิ่มข้อมูล – รออนุมัติ – ส่งงานจัดซื้อ – ตรวจความถูกต้อง – สั่งของ – ออกเลขที่ – เก็บสำเนา"],2,
 "อ้างอิง: ดูข้อ 7 ประกอบ\n\nโจทย์ให้สัญลักษณ์มา ให้แปลงข้อความในแต่ละตัวเลือกเป็นสัญลักษณ์เทียบ ○ D ⇨ ○ ▽ ○ □ ○\n\nข้อ 2: พิมพ์ใบสั่งของ = ○ → รออนุมัติ = D → ส่งงานจัดซื้อ = ⇨ → ออกเลขที่ = ○ → เก็บสำเนา = ▽ → สั่งของ = ○ → ตรวจความถูกต้อง = □ → เพิ่มข้อมูล = ○ ตรงทุกตัว\n\nวิธีคัดตัวเลือกให้เร็ว: ดูสัญลักษณ์ตัวที่ 2 คือ D (รอ)\n• ข้อ 1 และ 3 ตัวที่ 2 คือ 'ตรวจความถูกต้อง' (□) (ผิด)\n• ข้อ 4 ตัวที่ 2 คือ 'ส่งงานจัดซื้อ' (⇨) (ผิด)\n• ข้อ 5 ตัวที่ 2 คือ 'เพิ่มข้อมูล' (○) (ผิด)\nเหลือข้อ 2 ข้อเดียวที่ตัวที่ 2 คือ 'รออนุมัติ' (D)"),
Q(49,"ระบบฝากถอนเงินอัตโนมัติหรือเอทีเอ็ม ควบคุมโดยเครื่องคอมพิวเตอร์ขนาดใด",
 ["ซูเปอร์คอมพิวเตอร์","สถานีงาน","ไมโครคอมพิวเตอร์","เมนเฟรมคอมพิวเตอร์","มินิคอมพิวเตอร์"],4,
 "อ้างอิง: หน้า 104\n\nหลักการ: เมนเฟรมคอมพิวเตอร์ (Mainframe) เป็นเครื่องขนาดใหญ่ที่มีประสิทธิภาพสูงกว่ามินิคอมพิวเตอร์และไมโครคอมพิวเตอร์ นิยมใช้ในองค์การขนาดใหญ่ โดยเป็นศูนย์กลางของระบบคอมพิวเตอร์แบบกระจาย เช่น ธนาคารใหญ่ ๆ ระบบ ATM บริษัทสายการบิน บริษัทท่องเที่ยว บริษัทประกันภัย การไฟฟ้าฝ่ายผลิต สำนักงานสถิติแห่งชาติ หรือหน่วยงานที่มีเครือข่ายในสำนักงานหลายสาขา\n\nวิธีจำ: ลูกค้าหลายสาขาเชื่อมต่อเข้ามาศูนย์เดียว = Mainframe (ต่างจากข้อ 18 ที่ Supercomputer ใช้งานวิทยาศาสตร์)"),
Q(50,"ข้อใดคือวัตถุประสงค์ที่สำคัญของการจัดให้มี Private Office",
 ["เพื่อต้องการความสวยงาม","เพื่อความมีเกียรติภูมิในตำแหน่ง","เพื่อจัดสรรพื้นที่ตามระดับขั้น","เพื่อให้เป็นสัดส่วน","เพื่อให้เกิดความแตกต่างในแต่ละตำแหน่ง"],2,
 "อ้างอิง: หน้า 69\n\nวัตถุประสงค์ของการจัดให้มีสำนักงานส่วนบุคคล (Private Office) มี 3 ข้อ\n1. เพื่อหลีกเลี่ยงจากการรบกวนต่าง ๆ ในงานที่ต้องการสมาธิ\n2. เพื่อจัดที่ทำงานให้เป็นส่วนสัดในการปฏิบัติงานที่ต้องรักษาเป็นความลับ\n3. เพื่อเกียรติภูมิให้สมกับตำแหน่งงาน\n\nข้อ 4 'เพื่อให้เป็นสัดส่วน' ฟังคล้ายวัตถุประสงค์ข้อ 2 แต่ตัวเลือกไม่ได้พูดถึงความลับหรือสมาธิ เฉลยจึงเลือกข้อ 2 (เกียรติภูมิ) ซึ่งตรงกับวัตถุประสงค์ข้อ 3 ทั้งประโยค\n\nจำ 3 คำ: สมาธิ – ความลับ – เกียรติภูมิ"),
Q(51,"การเก็บเอกสารประเภทใดไม่ต้องเก็บถาวรตลอดไป",
 ["ข้อตกลงกับลูกจ้าง","อัตราค่าจ้าง","สัญญากับสหภาพแรงงาน","งบแสดงฐานะการเงิน","รายงานประจำปี"],2,
 "อ้างอิง: ดูข้อ 3 ประกอบ\n\nหลักการ: เอกสารที่ต้อง 'เก็บถาวรตลอดไป' คือ Vital (คุณค่าสูง) ได้แก่ ข้อตกลงกับลูกจ้าง, สัญญากับสหภาพแรงงาน, งบแสดงฐานะการเงิน, รายงานประจำปี ส่วน 'อัตราค่าจ้าง' เป็นเอกสารสำคัญ (Important) ที่มีคุณค่าราว 5–6 ปี เก็บไว้อ้างอิงแล้วทิ้งได้\n\nวิธีจำ: ตัวอย่างของ Important ในชีทมีคำเดียวคือ 'อัตราค่าจ้าง' จำคู่กันไว้"),
Q(52,"การจัดสายทางเดินของงานในสำนักงาน ควรหลีกเลี่ยงการจัดเป็นรูปลักษณะใด",
 ["รูปวงกลม","รูปตัว L","รูปตัว U","รูปตัว B","เส้นตรง"],4,
 "อ้างอิง: หน้า 63–65\n\nหลักประสิทธิภาพในการจัดแผนผังสำนักงาน (Office Layout)\n1. จัดให้สายทางเดินของงานเป็นเส้นตรงไปข้างหน้า เพื่อหลีกเลี่ยงการวกเวียนไปมา หรือจัดเป็นรูปวงกลม รูปตัว U หรือ L เพื่อลดการเคลื่อนไหวที่ไม่จำเป็น\n2. จัดให้มีทางออกยามฉุกเฉินอย่างเพียงพอ\n3. จัดทางเดินระหว่างหน่วยงานให้โล่งโปร่ง\n4. จัดให้โต๊ะหันหน้าไปทางเดียวกัน โดยให้หัวหน้างานอยู่ด้านหลังพนักงาน\n5. หน่วยงานที่ให้บริการรวมแก่หน่วยงานอื่น ๆ ควรตั้งอยู่ใกล้กับหน่วยงานที่รับบริการนั้น ๆ\n6. จัดหน่วยงานใหญ่ไว้ไกลหน่วยงานเล็ก เพื่อความสะดวกเมื่อต้องการขยายหน่วยงาน\n\nรูปที่เฉลยแนะนำ = เส้นตรง / วงกลม / U / L ส่วน 'รูปตัว B' ไม่อยู่ในรูปแนะนำ (มีลักษณะวกวนซ้อนกัน งานต้องเดินย้อนไปมา)\n\nโจทย์ 'หลีกเลี่ยง' → เลือกรูปที่ไม่อยู่ในรายการ"),
Q(53,"เส้นที่ใช้แบ่งช่องจำนวนเงินในแบบฟอร์ม เรียกว่าอะไร",
 ["เส้นหนัก","เส้นคู่","เส้นไข่ปลา","เส้นประสม 3 เส้น","เส้นธรรมดา"],3,
 "อ้างอิง: ดูข้อ 20 ประกอบ\n\nเส้นที่ใช้ออกแบบฟอร์มมี 5 ชนิด (หน้า 252–253)\n• เส้นคู่ (Double Line) = เฉพาะหัวและท้ายแบบฟอร์ม\n• เส้นหนัก (Heavy Line) = ขีดคั่นคอลัมน์หัวข้อย่อยจากหัวข้อใหญ่\n• เส้นไข่ปลา (Dotted Line) = แบ่งช่องจำนวนเงิน เช่น บาท สตางค์\n• เส้นประสม 3 เส้น (Combination Line) = แบ่งช่องเมื่อเปลี่ยนขึ้นหัวข้อใหม่\n• เส้นธรรมดา (Standard Weight Line) = ใช้ทั่ว ๆ ไป\n\nวิธีจำ: ไข่ปลา = เส้นประเม็ดเล็ก ๆ ใช้แบ่งช่องเงิน (บาท | สตางค์)"),
Q(54,"ธุรกิจที่มีสาขาอยู่ในสถานที่ต่าง ๆ เช่น ธุรกิจประเภทขนส่ง ควรเก็บเอกสารตามระบบใด",
 ["ระบบตัวอักษร","ระบบตัวเลข","ระบบวันที่","ระบบภูมิศาสตร์","ระบบสัญลักษณ์"],4,
 "อ้างอิง: ดูข้อ 19 ประกอบ\n\nหลักการ: ระบบภูมิศาสตร์ คือการเรียงเอกสารตามชื่อสถานที่ เป็นหมวดหมู่ตามอาณาเขตที่ตั้ง เช่น ภาค → จังหวัด → อำเภอ เหมาะกับธุรกิจที่มีสาขาอยู่ในสถานที่ต่าง ๆ เช่น ธุรกิจขนส่ง (หน้า 210–211)\n\nเทียบตัวเลือก: ตัวอักษร = เรียงตามชื่อ / ตัวเลข = เรียงตามเลขที่เอกสาร / วันที่ = เรียงตามเวลา / ภูมิศาสตร์ = เรียงตามที่ตั้ง  (ระบบสัญลักษณ์ไม่อยู่ในระบบทั้ง 4 ของชีท ดูข้อ 12)\n\nคำสำคัญในโจทย์: 'สาขาอยู่ในสถานที่ต่าง ๆ' = ภูมิศาสตร์"),
Q(55,"การจัดสำนักงานแบบเน้นทัศนียภาพหมายถึงข้อใด",
 ["จัดโดยใช้รูปภาพธรรมชาติประกอบการตกแต่ง","จัดโดยเปิดหน้าต่างมองเห็นทิวทัศน์","จัดโดยใช้กระจกใสมองผ่านเห็นทิวทัศน์","จัดโดยให้มีเสียงธรรมชาติในสำนักงาน","จัดให้มีไม้ประดับประกอบการตกแต่ง"],5,
 "อ้างอิง: หน้า 72–73\n\nหลักการ: การจัดแผนผังสำนักงานแบบเน้นทัศนียภาพหรือเน้นทิวทัศน์ (Landscape Approach) มีลักษณะดังนี้\n• ผสมผสานแบบโมดูลา (Modular) และแบบแผงกั้น (Partition) เข้าด้วยกัน\n• จัดให้มีไม้ดอกไม้ประดับในการตกแต่งด้วย (นี่คือจุดที่ตรงกับข้อ 5)\n• จัดตั้งเครื่องตกแต่งให้แยกกระจายไปตามจุดและมุมต่าง ๆ แทนการเรียงให้หันหน้าไปทางเดียวกันแบบดั้งเดิม\n• ไม่มีสำนักงานส่วนบุคคล\n• พื้นที่เปิด 80% และพื้นที่ปิด 20%\n\nข้อ 1–4 (รูปภาพ หน้าต่าง กระจก เสียงธรรมชาติ) เป็นตัวเลือกที่แต่งขึ้นจากคำว่า 'ทัศนียภาพ' ไม่มีในนิยามของชีท\n\nวิธีจำ: Landscape = ภูมิทัศน์ → มีต้นไม้ประดับ + เปิดโล่ง 80% (ข้อ 80 ถามต่อ)"),
Q(56,"การจัดเรียงลำดับตามระบบตัวอักษรที่เป็นชื่อกิจการ ข้อใดถูกต้องตามหลักวิชา\n1. บริษัท 77 ไนท์คลับ  2. ร้าน 59 เท็กซ์ไทล์  3. ร้าน 101 เพ็ทช้อป\n4. ห้างหุ้นส่วนจำกัด 911 ซอฟต์แวร์  5. บริษัท 455 สูทสากล จำกัด",
 ["2, 1, 3, 4, 5","5, 3, 1, 4, 2","3, 4, 1, 2, 5","5, 3, 1, 2, 4","4, 1, 5, 3, 2"],5,
 "อ้างอิง: ดูข้อ 5 ประกอบ\n\nหลักการ (เหมือนข้อ 5): ชื่อกิจการที่มีตัวเลข ให้อ่านเป็นคำก่อนแล้วจึงเรียงตามตัวอักษร ส่วนคำบอกประเภทกิจการ (บริษัท ร้าน ห้างหุ้นส่วนจำกัด) ย้ายไปไว้ในวงเล็บท้ายสุด\n\nแปลงตามเฉลย:\n4) 911 → เก้าหนึ่งหนึ่ง ซอฟต์แวร์ (ห้างหุ้นส่วนจำกัด)\n1) 77 → เจ็ดสิบเจ็ด ไนท์คลับ (บริษัท)\n5) 455 → สี่ห้าห้า สูทสากล จำกัด (บริษัท)\n3) 101 → หนึ่งศูนย์หนึ่ง เพ็ทช้อป (ร้าน)\n2) 59 → ห้าสิบเก้า เท็กซ์ไทล์ (ร้าน)\n\nเรียงตามพยัญชนะต้น: เก้า (ก) → เจ็ด (จ) → สี่ (ส) → หนึ่ง (ห+น) → ห้า (ห+า) = ข้อ 4, 1, 5, 3, 2\n\nสังเกต: เลข 3 หลักในเฉลยอ่านทีละหลัก (911, 455, 101) ส่วนเลข 2 หลักอ่านเป็นจำนวน (77, 59) และ 'หนึ่ง' มาก่อน 'ห้า' เพราะ ห+น เทียบกับ ห+สระ (พยัญชนะมาก่อนสระ)"),
Q(57,"การใช้คอมพิวเตอร์ในงานสำนักงานส่วนหน้า ได้แก่งานประเภทใด",
 ["งานรับฝาก–ถอนเงิน","งานสินค้าคงคลัง","งานบุคลากร","งานบัญชี","งานเร่งรัดหนี้สิน"],1,
 " หลักการ: สำนักงานส่วนหน้า (Front Office) คือฝ่ายบริการที่อยู่ส่วนหน้าของสำนักงาน ต้องพบปะลูกค้าหรือติดต่อสื่อสารกับบุคคลภายนอก เพื่อรับเรื่อง ปฏิบัติหน้าที่ในขั้นต้น และกลั่นกรองข้อมูลก่อนส่งต่อไปยังฝ่ายอื่น ดังนั้นงานที่ใช้คอมพิวเตอร์ในส่วนหน้า ได้แก่ งานรับฝาก–ถอนเงิน (ธุรกิจธนาคาร) และงานประชาสัมพันธ์\n\nเทียบตัวเลือก: สินค้าคงคลัง บุคลากร บัญชี เร่งรัดหนี้สิน เป็นงานภายในที่ไม่ต้องพบลูกค้าโดยตรง จึงเป็นสำนักงานส่วนหลัง\n\nวิธีจำ: ส่วนหน้า = เจอลูกค้า (ธนาคาร ประชาสัมพันธ์), ส่วนหลัง = งานภายใน"),
Q(58,"ข้อใดกล่าวผิดเกี่ยวกับการจัดสำนักงานแบบเปิดโดยใช้แผงกั้น",
 ["ตู้เอกสารติดอยู่กับแผงกั้น","การใช้แผงกั้นเสียค่าใช้จ่ายมากกว่าแบบเดิม","แผงกั้นเปลี่ยนแปลงรูปแบบใหม่ได้สะดวก","สายไฟสามารถเดินสายบนแผงกั้นได้","แผงกั้นใช้เป็นที่จัดแบ่งพื้นที่ทำงาน"],2,
 "อ้างอิง: หน้า 72\n\nหลักการ: การจัดสำนักงานแบบเปิดโดยใช้แผงกั้น (Partition Approach) คือการใช้ตู้เก็บของ ตู้เอกสาร ฯลฯ ติดอยู่กับแผงกั้น ซึ่งใช้เป็นที่จัดแบ่งพื้นที่ทำงาน ทำให้\n• เดินสายไฟบนแผงกั้นได้\n• เปลี่ยนแปลงรูปแบบใหม่ได้สะดวก\n• เสียค่าใช้จ่าย 'น้อยกว่า' แบบดั้งเดิมมาก\n\nข้อ 2 ผิดเพราะกลับความจริง (บอกว่าแพงกว่า) ส่วนข้อ 1, 3, 4, 5 ตรงกับหลักการทั้งหมด\n\nโจทย์ 'กล่าวผิด' → มองหาประโยคที่กลับข้อดีให้เป็นข้อเสีย"),
Q(59,"เส้นที่ใช้เฉพาะหัวและท้ายแบบฟอร์ม เรียกว่าอะไร",
 ["เส้นหนัก","เส้นคู่","เส้นไข่ปลา","เส้นประสม 3 เส้น","เส้นธรรมดา"],2,
 "อ้างอิง: ดูข้อ 20 ประกอบ\n\nเส้นคู่ (Double Line) ใช้เฉพาะหัวและท้ายแบบฟอร์มเท่านั้น (หน้า 252–253)\n\nวิธีจำ: คู่ = สองเส้นประกบหัว–ท้าย เหมือนกรอบปิดหัวท้ายของฟอร์ม ส่วนเส้นหนักใช้คั่นหัวข้อย่อย (ข้อ 20) เส้นไข่ปลาแบ่งช่องเงิน (ข้อ 53)"),
Q(60,"แผนผังลำดับขั้นการปฏิบัติงานที่แสดงนี้ตรงกับข้อใด   ○ → □ → ○ → ⇨ → ○ → D → ○ → ▽",
 ["พิมพ์ประกาศ – เสนออนุมัติ – ส่งงานสารบรรณ – ตรวจสอบรูปแบบ – รอประกาศ – เซ็นอนุมัติ – ลงเว็บไซต์ – เก็บสำเนาเข้าแฟ้ม","เซ็นอนุมัติ – พิมพ์ประกาศ – ตรวจสอบรูปแบบ – เสนออนุมัติ – ส่งงานสารบรรณ – รอประกาศ – เก็บสำเนาเข้าแฟ้ม – ลงเว็บไซต์","พิมพ์ประกาศ – ตรวจสอบรูปแบบ – เสนออนุมัติ – ส่งงานสารบรรณ – เซ็นอนุมัติ – รอประกาศ – ลงเว็บไซต์ – เก็บสำเนาเข้าแฟ้ม","เสนออนุมัติ – เซ็นอนุมัติ – พิมพ์ประกาศ – ตรวจสอบรูปแบบ – ส่งงานสารบรรณ – รอประกาศ – เก็บสำเนาเข้าแฟ้ม – ลงเว็บไซต์","รอประกาศ – พิมพ์ประกาศ – เซ็นอนุมัติ – ตรวจสอบรูปแบบ – เสนออนุมัติ – ส่งงานสารบรรณ – เก็บสำเนาเข้าแฟ้ม – ลงเว็บไซต์"],3,
 "อ้างอิง: ดูข้อ 7 ประกอบ\n\nโจทย์ให้สัญลักษณ์ 8 ตัว: ○ □ ○ ⇨ ○ D ○ ▽ ให้ตรวจว่าตัวเลือกไหนแปลงกลับเป็นสัญลักษณ์แล้วตรงกัน\n(○ ลงมือทำ / □ ตรวจสอบ / ⇨ ส่งต่อ / D รอ / ▽ เก็บ)\n\nข้อ 3: พิมพ์ประกาศ = ○ → ตรวจสอบรูปแบบ = □ → เสนออนุมัติ = ○ → ส่งงานสารบรรณ = ⇨ → เซ็นอนุมัติ = ○ → รอประกาศ = D → ลงเว็บไซต์ = ○ → เก็บสำเนาเข้าแฟ้ม = ▽ ตรงทุกตัว\n\nวิธีตัดตัวเลือกเร็ว: ตัวที่ 2 ต้องเป็น □ (ตรวจสอบรูปแบบ) → ข้อ 1 (เสนออนุมัติ), 2 (พิมพ์ประกาศ), 4 (เซ็นอนุมัติ), 5 (พิมพ์ประกาศ) ตัวที่ 2 ไม่ใช่ตรวจสอบ ตัดทิ้งได้เกือบทั้งหมด เหลือข้อ 3\n\nคำสำคัญ: ตัวสุดท้ายของผังคือ ▽ (เก็บ) ต้องจบด้วยการเก็บสำเนาเข้าแฟ้ม"),
Q(61,"ระบบงานใดที่ไม่จัดเป็นงานหลักของสำนักงานอัตโนมัติ",
 ["ระบบแฟ้มอิเล็กทรอนิกส์","ระบบไปรษณีย์อิเล็กทรอนิกส์","ระบบเซลลูล่า","ระบบเวิร์ดโพรเซสเซอร์","ระบบการประชุมทางไกล"],3,
 "อ้างอิง: หน้า 18\n\nหลักการ: ระบบสำคัญที่เป็นงานหลักของสำนักงานอัตโนมัติ (OA) มี 4 ระบบ\n1. ระบบประมวลคำ / เวิร์ดโพรเซสเซอร์ (Word Processor)\n2. ระบบแฟ้มอิเล็กทรอนิกส์\n3. ระบบไปรษณีย์อิเล็กทรอนิกส์ (E-mail)\n4. ระบบประชุมทางไกล\n\nข้อ 1, 2, 4, 5 ตรงกับ 4 ระบบนี้ (ข้อ 2 = ไปรษณีย์อิเล็กทรอนิกส์, ข้อ 4 = เวิร์ดโพรเซสเซอร์, ข้อ 5 = ประชุมทางไกล, ข้อ 1 = แฟ้มอิเล็กทรอนิกส์) ส่วน 'ระบบเซลลูล่า' ไม่อยู่ในรายการ\n\nจำ 4 ระบบ: พิมพ์ – เก็บ – ส่ง – ประชุม"),
Q(62,"บริษัทที่มีการจองแพ็กเกจท่องเที่ยวและสำรองที่พักโรงแรมออนไลน์ ใช้คอมพิวเตอร์ชนิดใด",
 ["Mainframe","Personnal Computer","Microcomputer","Supercomputer","Minicomputer"],1,
 "อ้างอิง: ดูข้อ 49 ประกอบ\n\nหลักการ: เมนเฟรมคอมพิวเตอร์ (Mainframe) เป็นเครื่องขนาดใหญ่ ประสิทธิภาพสูงกว่ามินิคอมพิวเตอร์และไมโครคอมพิวเตอร์ ใช้เป็นศูนย์กลางของระบบที่มีเครือข่ายหลายสาขา เช่น ธนาคาร ระบบ ATM บริษัทสายการบิน บริษัทท่องเที่ยว บริษัทประกันภัย (หน้า 104)\n\nโจทย์พูดถึง 'บริษัทท่องเที่ยว' + 'ออนไลน์' ซึ่งตรงกับรายชื่อผู้ใช้ Mainframe ส่วน Supercomputer ใช้กับงานวิทยาศาสตร์ที่คำนวณซับซ้อน (ข้อ 18, 23)\n\nวิธีจำ: ท่องเที่ยว/สายการบิน/ธนาคาร/ประกัน = Mainframe, พยากรณ์อากาศ/อวกาศ = Supercomputer"),
Q(63,"สีประเภทใดช่วยให้ห้องทำงานดูกว้างกว่าความเป็นจริง",
 ["สีสดประเภทร้อน","สีร้อนประเภทเข้ม","สีอ่อนประเภทเย็น","สีเข้มประเภทเย็น","สีมืดประเภทเย็น"],3,
 "อ้างอิง: หน้า 81\n\nหลักการ: สีที่ใช้ทาห้องทำงานส่งผลต่อการรับรู้ขนาดห้อง\n• สีอ่อน ๆ ประเภทเย็น (Light Cool) → ห้องแลดูกว้างขึ้น\n• สีมืด ๆ ประเภทร้อน (Dark Warm) → ห้องแลดูเล็กลง\n\nถ้าตัวเลือกใดมีคำว่า 'ร้อน' หรือ 'เข้ม/มืด' ตัดทิ้งได้เลย เพราะเป็นกลุ่มที่ทำให้ห้องแคบลง\n\nวิธีจำ: อ่อน + เย็น = โปร่ง กว้าง (เหมือนห้องสีฟ้าอ่อน) / มืด + ร้อน = แคบ อึดอัด"),
Q(64,"การจัดเรียงลำดับตามระบบตัวอักษรที่เป็นชื่อกิจการ ข้อใดถูกต้องตามหลักวิชา\n1. 1st Hotel  2. 101 Pet Shop  3. 700 Studio\n4. 2nd Bakery  5. 10000 Café  6. 99 Store",
 ["1, 4, 6, 2, 3, 5","1, 2, 5, 4, 3, 1","5, 3, 4, 2, 6, 1","6, 1, 2, 5, 4, 3","1, 6, 2, 4, 3, 5"],5,
 "อ้างอิง: ดูข้อ 5 ประกอบ\n\nหลักการ: ชื่อกิจการที่เป็นตัวเลข ให้อ่านออกเสียงเป็นคำ (ภาษาอังกฤษ) แล้วเรียง A–Z\n\nแปลง:\n1st Hotel → First Hotel (F)\n99 Store → Ninety-Nine Store (N)\n101 Pet Shop → One Hundred and One Pet Shop (O)\n2nd Bakery → Second Bakery (Sec)\n700 Studio → Seven Hundred Studio (Sev)\n10000 Café → Ten Thousand Café (T)\n\nเรียง: F → N → O → Se-c → Se-v → T\nSecond มาก่อน Seven เพราะตัวที่ 3 c มาก่อน v\n= ข้อ 1, 6, 2, 4, 3, 5\n\nกับดัก: 1st อ่านว่า First (ไม่ใช่ One) และ 2nd อ่านว่า Second"),
Q(65,"ข้อใดกล่าวได้ถูกต้อง",
 ["วิธีปฏิบัติคือแบบหรือท่าทีในการดำเนินงาน","การปรับปรุงระบบงานคือการออกแบบระบบงานใหม่ที่ยังไม่มีมาก่อน","ระบบคือชุดของระบบย่อยหลาย ๆ ระบบที่ประกอบด้วยวิธีปฏิบัติหลาย ๆ แบบ และแต่ละวิธีปฏิบัติเหล่านั้นประกอบด้วยหลาย ๆ วิธีการ","การทำงานที่ดีขึ้นจำเป็นต้องทำงานให้หนักขึ้นหรือเร็วขึ้น","วิธีการคือลำดับขั้นตอนการทำงานที่กำหนดไว้เป็นมาตรฐานแต่ละขั้นตอน"],3,
 "อ้างอิง: ดูข้อ 16 และ 44 ประกอบ\n\nหลักการ: ลำดับชั้นของคำศัพท์ในการจัดระบบงาน จากใหญ่ไปเล็ก\nระบบ (System) → ระบบย่อย → วิธีปฏิบัติ (Procedures) → วิธีการ (Methods)\n\nวิเคราะห์ตัวเลือกที่ผิด (ทุกข้อเป็นการสลับคำนิยาม)\n• ข้อ 1: 'แบบหรือท่าทีในการดำเนินงาน' คือนิยามของ 'วิธีการ' ไม่ใช่วิธีปฏิบัติ (ข้อ 87)\n• ข้อ 2: 'ออกแบบระบบงานใหม่ที่ยังไม่มีมาก่อน' คือ 'การจัดระบบงาน' ส่วนการปรับปรุงระบบงานคือปรับของเดิมให้ดีขึ้น (ข้อ 16)\n• ข้อ 4: การปรับปรุงงานคือหาวิธีให้ทำง่ายขึ้น ไม่ได้ให้พนักงานทำหนักหรือเร็วขึ้น (ข้อ 95)\n• ข้อ 5: 'ลำดับขั้นตอนมาตรฐาน' คือนิยามของ 'วิธีปฏิบัติ' ไม่ใช่วิธีการ (ข้อ 87)\n\nวิธีจำ: วิธีปฏิบัติ = ขั้นตอนเรียงตามลำดับ / วิธีการ = ท่า ท่าที รูปแบบการทำ"),
Q(66,"สำนักงาน มีความหมายตรงกับข้อใด",
 ["สถานที่ที่ใช้ในการฝึกอบรมพนักงาน","สถานที่ที่ใช้ดำเนินข่าวสารข้อมูล","สถานที่ที่ใช้นัดพบปะเจรจากัน","สถานที่ที่ใช้แสดงผลงานวิชาการ","สถานที่ที่ให้บริการแลกเปลี่ยนสินค้า"],2,
 "อ้างอิง: ดูข้อ 31 ประกอบ — หน้า 4–5\n\nหลักการ: สำนักงาน (Office) หมายถึง สถานที่ที่ใช้ในการดำเนินงานข่าวสารข้อมูลหรืองานหนังสือขององค์การ เป็นศูนย์กลางรวบรวมงานเอกสารหรือข้อเท็จจริง บริการข้อมูลข่าวสาร และติดต่อประสานงานกับหน่วยงานอื่น เปรียบเสมือนศูนย์ประสาทหรือสมองของมนุษย์\n\nข้อ 1, 3, 4, 5 เป็นหน้าที่ของสถานที่ประเภทอื่น (ศูนย์ฝึกอบรม ห้องประชุม นิทรรศการ ตลาด) ไม่ใช่นิยามของสำนักงาน\n\nคำสำคัญ: 'ข่าวสารข้อมูล / เอกสาร'"),
Q(67,"เครื่องใช้สำนักงานที่ดีมีลักษณะเช่นไร",
 ["ราคาสูง ใช้งานยาก ปลอดภัย","สวยงาม ราคาสูง ใช้งานง่าย","คงทน ราคาถูก ใช้งานยาก","ใช้งานง่าย ราคาถูก คงทน","ราคาถูก สวยงาม ใช้งานยาก"],4,
 "อ้างอิง: หน้า 93–94\n\nหลักการ: เครื่องใช้สำนักงานที่ดีต้องมีลักษณะ\n1. ใช้งานง่าย สะดวก รวดเร็ว\n2. ราคาถูก มีประสิทธิภาพสูง\n3. คงทน ปลอดภัย เชื่อถือได้\n\nวิธีตัดตัวเลือก: ตัดข้อที่มี 'ราคาสูง' หรือ 'ใช้งานยาก' ทิ้ง (ข้อ 1, 2, 3, 5 มีอย่างน้อยหนึ่งคำนี้) เหลือข้อ 4 ที่มีครบ 'ใช้งานง่าย + ราคาถูก + คงทน'\n\nหลักคิด: ดี = ง่าย + ถูก + ทน"),
Q(68,"จดหมายเวียนเพื่อเชิญประชุมจัดเป็นเอกสารแบบใด",
 ["เอกสารสำคัญ","เอกสารไม่จำเป็น","เอกสารคุณค่าสูง","เอกสารที่มีประโยชน์","เอกสารควรทำลาย"],4,
 " หลักการ: เอกสารแบ่งตามความสำคัญเป็น 4 ประเภท\n• ไม่จำเป็น (Nonessential) = คุณค่าระยะสั้นมาก\n• มีประโยชน์ (Helpful) = ใช้ปฏิบัติงานภายใน 4–5 สัปดาห์ เช่น จดหมายเวียนต่าง ๆ\n• สำคัญ (Important) = คุณค่านาน 5–6 ปี เช่น อัตราค่าจ้าง\n• คุณค่าสูง (Vital) = เก็บตลอดไป\n\nจดหมายเวียนเชิญประชุมใช้แค่ช่วงสั้น ๆ จนถึงวันประชุม จึงเป็น Helpful ('เอกสารควรทำลาย' ไม่ใช่ 1 ใน 4 ประเภทนี้)\n\nวิธีจำ: จดหมายเวียน = Helpful (ชีทยกเป็นตัวอย่างโดยตรง)"),
Q(69,"ระบบงานที่ดีตามคุณลักษณะของ Effectiveness หมายถึงข้อใด",
 ["มีความง่ายในการปฏิบัติ","มีประสิทธิภาพ","มีความเชื่อถือได้","มีประสิทธิผล","ได้รับการยอมรับ"],4,
 "อ้างอิง: หน้า 145\n\nหลักการ: ระบบงานที่ดีควรประกอบด้วยคุณลักษณะ 6 ข้อ\n1. มีประสิทธิผล (Effectiveness)\n2. มีประสิทธิภาพ (Efficiency)\n3. มีความเชื่อถือได้ (Dependability)\n4. มีความยืดหยุ่น (Flexibility)\n5. มีความง่าย (Simplicity)\n6. ได้รับการยอมรับ (Acceptability)\n\nเทียบตัวเลือก: ข้อ 1 = Simplicity / ข้อ 2 = Efficiency (กับดัก: ชื่อคล้าย Effectiveness) / ข้อ 3 = Dependability / ข้อ 5 = Acceptability\n\nวิธีจำ: Effectiveness = ประสิทธิ'ผล' (ทำได้ผลตามเป้าหมาย) / Efficiency = ประสิทธิ'ภาพ' (ทำได้คุ้ม ใช้ทรัพยากรน้อย) — จำ ผล = E-ff-ect (effect = ผล)"),
Q(70,"คำว่าครุภัณฑ์ในระบบราชการ หมายถึง",
 ["ของใช้ที่คงทนถาวร","สิ่งของที่มีน้ำหนักมาก","ของใช้ที่มีราคาแพง","ของใช้สิ้นเปลือง","ถูกทุกข้อ"],1,
 " หลักการ: 'ครุภัณฑ์' ในระบบราชการ หมายถึง ของใช้ที่มีลักษณะคงทนถาวร มีอายุการใช้งานยาวนาน เช่น ตู้ โต๊ะ เก้าอี้ รถยนต์\n\nเทียบตัวเลือก: ข้อ 2 (น้ำหนักมาก) และข้อ 3 (ราคาแพง) ไม่ใช่เกณฑ์ของคำนี้ / ข้อ 4 'ของใช้สิ้นเปลือง' ตรงข้ามกับครุภัณฑ์ (ของที่ใช้แล้วหมดไป) / ข้อ 5 ผิดเพราะมีข้อผิดปนอยู่\n\nวิธีจำ: ครุภัณฑ์ = ของที่ใช้ทนนาน (โต๊ะ เก้าอี้)",false,true),
Q(71,"ข้อใดเป็นข้อความที่แสดงให้ทราบว่าเป็นการเริ่มเรื่องในแบบฟอร์ม",
 ["ใบสมัครงาน","เขียนด้วยตัวอักษรพิมพ์ใหญ่","ชื่อ........... นามสกุล...........","ประวัติส่วนตัว","ลงชื่อ__________"],3,
 "อ้างอิง: หน้า 238–239\n\nหลักการ: โครงร่างของแบบฟอร์มแบ่งเป็น 5 ตอน\n1. ชื่อแบบฟอร์ม = แสดงว่าแบบฟอร์มนั้นคืออะไร เช่น ใบสมัครงาน\n2. คำสั่งหรือข้อแนะนำ = ข้อความอธิบายวิธีใช้แบบฟอร์ม เป็นส่วนที่สำคัญน้อยที่สุด บางครั้งไม่ต้องมีก็ได้\n3. การเริ่มเรื่อง = ข้อความนำที่บอกว่าแบบฟอร์มนี้เกี่ยวกับใคร อะไร เมื่อไหร่ เช่น ชื่อ–นามสกุล วัน/เดือน/ปีเกิด อายุ ที่อยู่ สถานภาพ อาชีพ\n4. เนื้อเรื่อง = ข้อความหรือสถิติตัวเลขที่เป็นสาระสำคัญ เช่น ประวัติส่วนตัว\n5. ปิดท้าย = ข้อความปิดท้าย ส่วนมากเป็นการลงนาม (ลงชื่อ) ของผู้ใช้และ/หรือผู้อนุมัติ\n\nจับคู่ตัวเลือก: (1) ใบสมัครงาน = ตอน 1 / (2) เขียนด้วยตัวอักษรพิมพ์ใหญ่ = ตอน 2 / (3) ชื่อ... นามสกุล... = ตอน 3  / (4) ประวัติส่วนตัว = ตอน 4 / (5) ลงชื่อ = ตอน 5\n\nวิธีจำ: ชื่อ → คำสั่ง → เริ่มเรื่อง (ใคร) → เนื้อเรื่อง (สาระ) → ปิดท้าย (เซ็น)"),
Q(72,"การเว้นช่องว่างตามแนวนอนในระยะ 1 นิ้ว ในแบบฟอร์ม เพื่อกำหนดช่องไฟเอกสารที่พิมพ์ด้วยเครื่องและเอกสารที่เขียนด้วยมือ ใส่ตัวอักษรได้กี่ตัวอักษรจึงจะเหมาะสม",
 ["15 ตัว, 10 ตัว","8 ตัว, 6 ตัว","14 ตัว, 12 ตัว","12 ตัว, 8 ตัว","10 ตัว, 6 ตัว"],4,
 "อ้างอิง: หน้า 241\n\nหลักการ: การเว้นช่องว่างตามแนวนอน (Horizontal Spacing) คือการเว้นช่องไฟให้กรอกข้อมูลลงบนแบบฟอร์มในระยะ 1 นิ้ว\n• กรอกด้วยเครื่องพิมพ์ดีด → ใส่ตัวอักษรได้ 10–12 ตัว\n• กรอกด้วยมือ → ใส่ตัวอักษรได้ 8 ตัว\n\nตัวเลือกคู่ที่ตรงกับ 'เครื่อง 10–12, มือ 8' คือข้อ 4 (12, 8) ข้ออื่นมีตัวเลขเครื่องหรือมือที่เกินช่วงนี้\n\nวิธีจำ: แนวนอน = ตัวอักษรต่อนิ้ว (เครื่อง 10–12 / มือ 8) ส่วนแนวตั้ง = บรรทัดต่อนิ้ว (ข้อ 89)"),
Q(73,"ข้อใดไม่จัดเป็นข้อดีของการรวมอำนาจงานสำนักงาน",
 ["มีวิธีปฏิบัติงานเป็นแบบอย่างเดียวกัน","บุคลากรมีความชำนาญเฉพาะอย่าง","เหมาะกับงานที่ต้องการความลับ","มีมาตรฐานกระบวนการทำงาน","ลดการซ้ำซ้อนด้านเครื่องมือเครื่องใช้"],3,
 "อ้างอิง: หน้า 24–25\n\nหลักการ: ข้อดีของการรวมอำนาจงานสำนักงาน (รวมงานไว้ที่ศูนย์กลาง) ได้แก่\n1. มีวิธีปฏิบัติงานเป็นแบบอย่างเดียวกัน\n2. ลดการซ้ำซ้อนด้านกำลังคนและเครื่องมือเครื่องใช้\n3. ลดจำนวนสำเนาเอกสารที่ต้องเก็บ\n4. มีมาตรฐานกระบวนการทำงาน/ปฏิบัติงาน\n5. ใช้ทรัพยากรได้เต็มที่ เพราะบุคลากรมีความชำนาญเฉพาะอย่าง\n\nเทียบตัวเลือก: ข้อ 1 = ข้อดีที่ 1 / ข้อ 2 = ข้อดีที่ 5 / ข้อ 4 = ข้อดีที่ 4 / ข้อ 5 = ข้อดีที่ 2\nส่วนข้อ 3 'เหมาะกับงานที่ต้องการความลับ' ไม่อยู่ในรายการ (งานที่รวมไว้ศูนย์กลางมีหลายคนใช้ร่วมกัน จึงไม่เหมาะกับงานลับ)\n\nโจทย์ 'ไม่จัดเป็นข้อดี' → เลือกข้อที่ไม่อยู่ในรายการ 5 ข้อ"),
Q(74,"การรายงานทางการบริหารจากเบื้องบนลงสู่เบื้องล่างเป็นการรายงานในเรื่องใด",
 ["สภาพแวดล้อมขององค์การ","สภาวะการแข่งขันกับคู่แข่งขัน","ผลการดำเนินงาน","แนวนโยบายข้อปฏิบัติ","การวิเคราะห์ความเป็นไปภายใน"],4,
 "อ้างอิง: หน้า 258\n\nหลักการ: การรายงานทางการบริหารแบ่งเป็น 2 ทิศทาง\n1. จากเบื้องบนลงสู่เบื้องล่าง (ผู้บริหาร → พนักงาน) = คำสั่ง แนวนโยบายหรือแนวทางการปฏิบัติงาน รวมทั้งกติกา กฎเกณฑ์ กฎระเบียบหรือระเบียบข้อบังคับ และข้อปฏิบัติต่าง ๆ\n2. จากเบื้องล่างขึ้นสู่เบื้องบน (พนักงาน → ผู้บริหาร) = ผลการดำเนินงานหรือการปฏิบัติงาน สภาพแวดล้อมขององค์การ สภาวะการแข่งขันกับคู่แข่งขัน การวิเคราะห์ความเป็นไปภายใน\n\nข้อ 1, 2, 3, 5 เป็นข้อมูลที่ระดับล่างรายงานขึ้นไป จึงผิด\n\nวิธีจำ: บนลงล่าง = 'สั่งการ' (นโยบาย คำสั่ง กฎ) / ล่างขึ้นบน = 'รายงานข้อมูล' (ผลงาน สถานการณ์) — ข้อ 99 ถามกลับด้าน"),
Q(75,"หลักของการติดต่อสื่อสารด้วยการเขียนควรคำนึงถึง ความถูกต้อง ซึ่งตรงกับคำใด",
 ["Concreteness","Courtesy","Conciseness","Consideration","Correctness"],5,
 "อ้างอิง: หน้า 266–268\n\nหลักประสิทธิภาพในการติดต่อสื่อสารทางธุรกิจด้วยการเขียน มี 7 ประการ (7C's)\n1. ความชัดเจน = Clarity\n2. ความกะทัดรัด = Conciseness\n3. ความสุภาพอ่อนน้อม = Courtesy\n4. ความสมบูรณ์ = Completeness\n5. การพิจารณาไตร่ตรอง = Consideration\n6. ความถูกต้อง = Correctness\n7. ความหนักแน่น = Concreteness\n\nวิธีจำ: ทั้ง 7 คำขึ้นต้นด้วย C (จึงชื่อ 7C's) — ระวังกับดัก Concreteness = 'หนักแน่น' ไม่ใช่ 'ถูกต้อง' และ Conciseness = 'กะทัดรัด' (ข้อ 83 ใช้ต่อ)"),
Q(76,"ข้อใดเป็นข้อความที่แสดงให้ทราบว่าเป็นเนื้อเรื่องในแบบฟอร์ม",
 ["ใบสมัครงาน","เขียนด้วยตัวอักษรพิมพ์ใหญ่","ชื่อ........... นามสกุล...........","ประวัติส่วนตัว","ลงชื่อ__________"],4,
 "อ้างอิง: ดูข้อ 71 ประกอบ\n\nแบบฟอร์มมี 5 ตอน: ชื่อแบบฟอร์ม → คำสั่ง → การเริ่มเรื่อง → เนื้อเรื่อง → ปิดท้าย\n'เนื้อเรื่อง' คือข้อความหรือสถิติตัวเลขที่เป็นสาระสำคัญของเรื่อง เช่น ประวัติส่วนตัว\n\nจับคู่ตัวเลือก: ใบสมัครงาน = ชื่อแบบฟอร์ม / เขียนด้วยตัวอักษรพิมพ์ใหญ่ = คำสั่ง / ชื่อ... นามสกุล... = การเริ่มเรื่อง (ข้อ 71) / ประวัติส่วนตัว = เนื้อเรื่อง  / ลงชื่อ = ปิดท้าย\n\nข้อ 71 และ 76 ใช้ตัวเลือกชุดเดียวกัน ต่างกันที่ถามตอน 'เริ่มเรื่อง' (ตอบข้อ 3) กับตอน 'เนื้อเรื่อง' (ตอบข้อ 4)"),
Q(77,"การจัดเรียงลำดับตามระบบตัวอักษรที่เป็นชื่อคน ข้อใดเรียงลำดับถูกต้องตามหลักวิชา\n1. เด็กชายธำรง คงสกุล  2. พันโทธุรการ ศรีสง่า  3. เด็กหญิงธารีณี ปราณีต\n4. แพทย์หญิงธีรวรรณ นิยมดี  5. รองศาสตราจารย์ไธสง ปานตาม  6. นางธิดา มีคุณธรรม",
 ["6, 2, 1, 3, 4, 5","3, 6, 4, 2, 1, 5","3, 1, 6, 4, 2, 5","4, 5, 2, 6, 1, 3","1, 6, 2, 4, 5, 3"],3,
 "อ้างอิง: ดูข้อ 5 ประกอบ\n\nหลักการ: ตัดยศ/ตำแหน่ง/คำนำหน้านามออกไปใส่วงเล็บท้ายชื่อ แล้วเรียงตามชื่อตัว\n\nผลการเรียงตามเฉลย:\n1) ธารีณี ปราณีต (เด็กหญิง) = ข้อ 3\n2) ธำรง คงสกุล (เด็กชาย) = ข้อ 1\n3) ธิดา มีคุณธรรม (นาง) = ข้อ 6\n4) ธีรวรรณ นิยมดี (แพทย์หญิง) = ข้อ 4\n5) ธุรการ ศรีสง่า (พันโท) = ข้อ 2\n6) ไธสง ปานตาม (รองศาสตราจารย์) = ข้อ 5\n\nวิธีเรียง: ทุกชื่อขึ้นต้น 'ธ' จึงดูสระถัดไปตามลำดับ า → ำ → ิ → ี → ุ และชื่อที่ขึ้นต้นด้วยสระหน้า (ไธสง) ถูกวางไว้ท้ายสุดตามเฉลย (เหมือนข้อ 6 ที่ 'ไปรมา' อยู่ท้ายสุด)"),
Q(78,"องค์ประกอบของระบบคอมพิวเตอร์ที่ทำหน้าที่ในการควบคุมการทำงาน คำนวณค่า คือ",
 ["แป้นคีย์","หน่วยเก็บข้อมูลทุติยภูมิ","หน่วยประมวลผลกลาง","หน่วยความจำ","อุปกรณ์แสดงผล"],3,
 "อ้างอิง: หน้า 105–106\n\nหลักการ: หน่วยประมวลผลกลาง (Central Processing Unit) ทำหน้าที่ควบคุมการทำงานตามคำสั่งและคำนวณค่า เปรียบได้กับสมองของมนุษย์\n\nเทียบตัวเลือก: แป้นคีย์ = Input (ป้อนข้อมูล) / หน่วยความจำและหน่วยเก็บข้อมูล = เก็บข้อมูลและคำสั่ง / อุปกรณ์แสดงผล = Output\n\nวิธีจำ: ควบคุม + คำนวณ = สมอง = CPU"),
Q(79,"สีส้ม ใช้สีเป็นสัญญาณบอกถึงอะไร",
 ["ใช้บอกถึงความปลอดภัย","ใช้บอกเตือนว่าเครื่องจักรกำลังอยู่ในระหว่างซ่อมแซม","ใช้บอกอันตรายจากแสงเอกซเรย์","ใช้บอกให้ระวังอันตราย อาจตก หกล้มลงได้","ใช้บอกทางจราจร"],4,
 "อ้างอิง: ดูข้อ 35 ประกอบ — หน้า 79\n\nสีเพื่อความปลอดภัย\n• สีแดงสด = เครื่องมือดับเพลิง สัญญาณอันตราย สัญญาณให้หยุด\n• สีส้ม = บอกให้ระวังอันตราย ซึ่งอาจจะสะดุด ตก หรือหกล้มลงไปได้\n• สีเขียวสด = ความปลอดภัย เครื่องมือปฐมพยาบาล (ข้อ 1)\n• สีน้ำเงินสด = เครื่องจักรกำลังซ่อมแซม (ข้อ 2)\n• สีม่วงแดงสด = อันตรายจากแสงเอกซเรย์ (ข้อ 3)\n• สีขาวดำ = ทางจราจร และเครื่องหมายพนักงานแม่บ้าน (ข้อ 5)\n\nวิธีจำ: ส้ม = ระวังสะดุด ตก หกล้ม (เหมือนป้ายเตือนพื้นลื่น) ส่วนแดง = หยุด/ไฟไหม้"),
Q(80,"ข้อใดกล่าวผิดเกี่ยวกับการจัดแผนผังสำนักงานแบบ Landscape Approach",
 ["ไม่มีการจัดสำนักงานส่วนบุคคล","พื้นที่เปิด 80% พื้นที่ปิด 20%","เครื่องตกแต่งแยกกระจายไว้ตามจุดและมุมต่าง ๆ","ใช้แผงกั้นในการจัดแบ่งห้องใหญ่เป็นห้องเล็ก ๆ","เครื่องใช้และเครื่องตกแต่งจัดตั้งเรียงหันหน้าไปทิศทางเดียวกัน"],5,
 "อ้างอิง: ดูข้อ 55 ประกอบ — หน้า 72–73\n\nลักษณะของ Landscape Approach: ผสมแบบโมดูลากับแบบแผงกั้น / มีไม้ดอกไม้ประดับ / จัดเครื่องตกแต่งให้แยกกระจายไปตามจุดและมุมต่าง ๆ แทนการเรียงหันหน้าไปทางเดียวกันแบบดั้งเดิม / ไม่มีสำนักงานส่วนบุคคล / พื้นที่เปิด 80% ปิด 20%\n\nเทียบตัวเลือก: ข้อ 1 (ถูก) ไม่มีสำนักงานส่วนบุคคล / ข้อ 2 (ถูก) 80:20 / ข้อ 3 (ถูก) กระจายตามจุดและมุม / ข้อ 4 (ถูก) ใช้แผงกั้นแบ่งห้อง\nข้อ 5 ผิด เพราะการเรียงหันหน้าไปทางเดียวกันเป็นแบบ 'ดั้งเดิม' ซึ่งแบบ Landscape ตั้งใจเลิกใช้\n\nโจทย์ 'กล่าวผิด' → หาข้อที่ตรงกับแบบดั้งเดิม (หันหน้าทางเดียวกัน)"),
Q(81,"การใช้ซองแบบ Window Envelopes เพื่ออะไร",
 ["ความสวยงาม","ป้องกันการใส่จดหมายผิดซอง","เอกลักษณ์ของแต่ละองค์การ","ประหยัดค่าใช้จ่ายในการส่งจดหมาย","สะดวกในการเก็บรักษาจดหมาย"],2,
 "อ้างอิง: หน้า 276\n\nหลักการ: Window Envelopes คือซองที่ตัดด้านหน้าตรงที่จะจ่ายหน้าซองให้เป็นช่องโหว่ หรือติดกระดาษแก้วไว้ ส่วนการจ่ายหน้าซองให้พิมพ์ไว้บนด้านหลังของตัวจดหมาย กะให้ตรงพอดีกับช่องโหว่ เพื่อให้มองเห็นชื่อและที่อยู่ของผู้รับ\n\nผลที่ได้: ไม่ต้องเขียนหน้าซองซ้ำ และ 'ป้องกันไม่ให้ใส่จดหมายผิดซอง' เพราะชื่อบนตัวจดหมายคือชื่อที่ปรากฏบนซอง\n\nวิธีจำ: ซองมีหน้าต่าง = มองเห็นชื่อจากจดหมายข้างใน = จดหมายไม่ผิดซอง"),
Q(82,"มาตรฐานด้านปริมาณ หมายถึง",
 ["การกำหนดผลผลิตเพื่อใช้วัดหน่วยงานต่อหน่วยเวลา","การกำหนดลักษณะอันเป็นที่ยอมรับเกี่ยวกับพื้นที่หรือวัตถุ","การวัดความละเอียดความถูกต้องของงาน","การกำหนดความพึงพอใจในการทำงาน","ไม่มีข้อถูก"],1,
 "อ้างอิง: หน้า 293\n\nหลักการ: มาตรฐานงานสำนักงานมี 3 ประเภท\n1. มาตรฐานด้านปริมาณ = กำหนดผลผลิตไว้เป็นหน่วยงาน เพื่อใช้วัดหน่วยงานต่อหน่วยเวลา  (เช่น พิมพ์ได้กี่หน้าต่อชั่วโมง)\n2. มาตรฐานด้านคุณภาพ = วัดความละเอียดหรือความถูกต้องของงาน → คือข้อ 3\n3. มาตรฐานเชิงพรรณนา = กำหนดลักษณะอันเป็นที่ยอมรับเกี่ยวกับพื้นที่หรือวัตถุ → คือข้อ 2\n\nข้อ 4 'ความพึงพอใจในการทำงาน' ไม่ใช่มาตรฐานงานสำนักงานประเภทใดในชีท\n\nวิธีจำ: ปริมาณ = นับจำนวน (ต่อเวลา) / คุณภาพ = ถูกต้อง ละเอียด / พรรณนา = บรรยายลักษณะ",false,true),
Q(83,"ข้อใดไม่จัดอยู่ในหลักประสิทธิภาพในการเขียนทางธุรกิจ (7C's)",
 ["ความกะทัดรัด","ความสุภาพอ่อนน้อม","ความชัดเจน","ความสอดคล้อง","ความหนักแน่น"],4,
 "อ้างอิง: ดูข้อ 75 ประกอบ\n\n7C's ที่ถูกต้อง: ความชัดเจน (Clarity) / ความกะทัดรัด (Conciseness) / ความสุภาพอ่อนน้อม (Courtesy) / ความสมบูรณ์ (Completeness) / การพิจารณาไตร่ตรอง (Consideration) / ความถูกต้อง (Correctness) / ความหนักแน่น (Concreteness)\n\nเทียบตัวเลือก: ข้อ 1 = Conciseness / ข้อ 2 = Courtesy / ข้อ 3 = Clarity / ข้อ 5 = Concreteness ล้วนอยู่ในรายการ ส่วน 'ความสอดคล้อง' ไม่มีในรายการ\n\nวิธีจำ: ขึ้นต้นด้วย C ทั้งหมด — ความสอดคล้อง (Consistency/Coherence) ไม่ใช่หนึ่งใน 7C's ของชีทนี้"),
Q(84,"แผนผังภาระหน้าที่งานแสดงให้ทราบถึงเรื่องใด",
 ["จัดลำดับขั้นการปฏิบัติงาน","จัดสายทางเดินของงาน","จัดแสดงการเคลื่อนไหวภายในพื้นที่สำนักงาน","จัดแบ่งความรับผิดชอบในการทำงาน","จัดแผนการติดต่องานระหว่างพนักงานและหัวหน้างาน"],4,
 "อ้างอิง: หน้า 182\n\nหลักการ: แผนผังภาระหน้าที่งาน (Work Load Chart) หรืออาจเรียกว่า แผนผังการแบ่งงาน (Work Distribution Chart) เป็นแผนผังที่แสดงให้ทราบถึงการจัดแบ่งความรับผิดชอบในการทำงาน เป็นเครื่องมือสำคัญในการปรับปรุงระบบงานให้มีประสิทธิภาพ\n\nเทียบกับแผนผังอื่นที่ชีทกล่าวถึง: ผังลำดับขั้นการปฏิบัติงาน (Flow Process Chart) = ข้อ 1 / แผนผังสำนักงาน (Layout) = ข้อ 2 และ 3\n\nวิธีจำ: Work Load / Work Distribution = ใครรับผิดชอบงานอะไร (แบ่งงาน)"),
Q(85,"การจัดเก็บเอกสาร โดยเรียงตามระบบภูมิศาสตร์ ข้อใดเรียงถูกต้อง\n1. สุโขทัย ภาคเหนือ  2. สกลนคร ภาคตะวันออกเฉียงเหนือ  3. สระแก้ว ภาคตะวันออก\n4. สุราษฎร์ธานี ภาคใต้  5. สุพรรณบุรี ภาคตะวันตก  6. สิงห์บุรี ภาคกลาง",
 ["3, 6, 5, 1, 2, 4","6, 1, 5, 4, 2, 3","6, 5, 3, 2, 4, 1","3, 1, 4, 2, 6, 5","2, 6, 5, 4, 1, 3"],3,
 "อ้างอิง: ดูข้อ 19 ประกอบ\n\nหลักการ: ระบบภูมิศาสตร์ = ระบบตัวอักษรที่ใช้ชื่อสถานที่เป็นดัชนี เรียงเป็นหมวดหมู่ตามอาณาเขต เริ่มจาก 'ภาค' ก่อน แล้วจึง 'จังหวัด' (ภาค → จังหวัด → อำเภอ)\n\nลำดับตามเฉลย:\n1) ภาคกลาง — สิงห์บุรี = ข้อ 6\n2) ภาคตะวันตก — สุพรรณบุรี = ข้อ 5\n3) ภาคตะวันออก — สระแก้ว = ข้อ 3\n4) ภาคตะวันออกเฉียงเหนือ — สกลนคร = ข้อ 2\n5) ภาคใต้ — สุราษฎร์ธานี = ข้อ 4\n6) ภาคเหนือ — สุโขทัย = ข้อ 1\n\nวิธีเรียงชื่อภาค: กลาง (ก) → ตะวันตก (ต-ต) → ตะวันออก (ต-อ) → ตะวันออกเฉียงเหนือ (ยาวกว่า จึงตามหลัง 'ตะวันออก') → ใต้ → เหนือ (ใต้ และ เหนือ ขึ้นต้นด้วยสระหน้า จึงอยู่ท้าย โดย ต มาก่อน น) ถ้าเป็นภาคเดียวกันจึงค่อยเรียงตามชื่อจังหวัด\nกับดัก: อย่าเรียงตามชื่อจังหวัดก่อน ต้องเรียงตาม 'ภาค' ก่อนเสมอ"),
Q(86,"หลักเออร์โกโนมิกส์ หมายถึง",
 ["ศาสตร์ที่ว่าด้วยความสัมพันธ์ระหว่างรูปร่างกับการเคลื่อนไหวในการทำงาน","ศาสตร์ที่ว่าด้วยความสัมพันธ์ระหว่างเวลากับการเคลื่อนไหวในการทำงาน","ศาสตร์ที่ว่าด้วยความสัมพันธ์ระหว่างสุขภาพกับเทคโนโลยี","ศาสตร์ที่ว่าด้วยความสัมพันธ์ระหว่างร่างกายมนุษย์กับสภาพแวดล้อมในการทำงาน","ไม่มีข้อใดถูก"],4,
 "อ้างอิง: หน้า 52\n\nหลักการ: เออร์โกโนมิกส์ (Ergonomics) หมายถึง ศาสตร์ที่ว่าด้วยความสัมพันธ์ระหว่างคนทำงานกับสภาพแวดล้อมในการทำงาน ครอบคลุมการศึกษาเกี่ยวกับสรีระหรือร่างกายของมนุษย์ และความสะดวกสบายในการทำงาน รวมทั้งการออกแบบสภาพแวดล้อมในการทำงาน โดยคำนึงถึงเงื่อนไขทางสังคมและจิตวิทยาไปพร้อมกัน\n\nเทียบตัวเลือก: ข้อ 1 (รูปร่างกับการเคลื่อนไหว) และข้อ 2 (เวลากับการเคลื่อนไหว) เป็นเรื่องการศึกษาการเคลื่อนไหวและเวลา ไม่ใช่นิยามของเออร์โกโนมิกส์ / ข้อ 3 สุขภาพกับเทคโนโลยี ไม่ตรงนิยาม\n\nวิธีจำ: Ergonomics = คน (ร่างกาย) + สภาพแวดล้อมการทำงาน ให้สบาย เหมาะกับคน",false,true),
Q(87,"ความถนัด ท่าทางและรูปแบบในการปฏิบัติงาน หมายถึงข้อใด",
 ["วิธีปฏิบัติ","ดำเนินการ","วิธีการ","ระบบ","กระบวนการ"],3,
 "อ้างอิง: หน้า 144\n\nหลักการ: สองคำนี้ต่างกัน และออกข้อสอบสลับบ่อย\n• วิธีการ (Methods) = ความถนัด รูปแบบ หรือท่าทีในการดำเนินงาน (ทำ 'ท่า' ไหน แบบไหน)\n• วิธีปฏิบัติ (Procedures) = กระบวนการหรือลำดับขั้นตอนการปฏิบัติงาน ที่กำหนดไว้เป็นมาตรฐานการทำงานแต่ละขั้นตอนตั้งแต่เริ่มต้นจนแล้วเสร็จ\n\nลำดับชั้น: ระบบ → วิธีปฏิบัติ → วิธีการ (ข้อ 44, 65)\n\nวิธีจำ: วิธีการ = ท่า/รูปแบบ, วิธีปฏิบัติ = ขั้นตอนเรียงลำดับ"),
Q(88,"ข้อใดไม่ควรนำมาใช้ทำเป็นดัชนีเพื่อช่วยในการค้นหา",
 ["ชื่อเรื่อง","หมายเลขโทรศัพท์","วันเดือนปี","ชื่อบุคคล","ชื่อธุรกิจ"],2,
 "อ้างอิง: หน้า 214\n\nหลักการ: การทำดัชนีทำเพื่อเป็นเครื่องมือช่วยค้นหาเอกสารที่ต้องการนำมาใช้ได้ทันท่วงที ดังนั้นสิ่งที่นำมาทำดัชนีต้องเป็นสิ่งสำคัญที่สุดที่ผู้ต้องการใช้เอกสารมักอ้างอิงในการขอยืมเอกสาร เช่น วันเดือนปี ชื่อเรื่อง ชื่อบุคคล ชื่อธุรกิจ (บริษัท/ห้างร้าน) หรือชื่อสถานที่ตั้ง\n\nข้อ 1, 3, 4, 5 ตรงกับตัวอย่างของชีท ส่วน 'หมายเลขโทรศัพท์' ไม่ใช่สิ่งที่คนใช้อ้างอิงเวลาขอยืมเอกสาร\n\nวิธีจำ: ดัชนี = สิ่งที่ใช้ 'เรียกหาเอกสาร' (เรื่องอะไร ใคร ที่ไหน เมื่อไหร่)"),
Q(89,"การเว้นช่องว่างตามแนวตั้งในระยะ 1 นิ้ว ในแบบฟอร์มเพื่อกำหนดจำนวนบรรทัดเอกสารที่พิมพ์ด้วยเครื่องและเอกสารที่เขียนด้วยมือ ควรเว้นกี่บรรทัดจึงจะเหมาะสม",
 ["7 บรรทัด, 5 บรรทัด","6 บรรทัด, 4 บรรทัด","5 บรรทัด, 6 บรรทัด","8 บรรทัด, 6 บรรทัด","5 บรรทัด, 3 บรรทัด"],2,
 "อ้างอิง: หน้า 241\n\nหลักการ: การเว้นช่องว่างตามแนวตั้ง (Vertical Spacing) คือการเว้นบรรทัดในระยะ 1 นิ้ว\n• แบบฟอร์มที่กรอกด้วยเครื่องพิมพ์ดีด → ควรเว้น 3–6 บรรทัด\n• แบบฟอร์มที่กรอกด้วยมือ → ควรเว้น 4 บรรทัด\n\nวิเคราะห์ตัวเลือก: คู่ (เครื่อง, มือ) ที่เข้ากับช่วงข้างบนคือข้อ 2 (6, 4)  — ข้อ 1 (7, 5) ข้อ 4 (8, 6) เกินช่วงของเครื่องพิมพ์ดีด / ข้อ 3 (5, 6) เขียนมือ 6 บรรทัดมากเกินไป / ข้อ 5 (5, 3) เขียนมือ 3 บรรทัด ไม่ใช่ 4\n\nวิธีจำ: แนวนอนนับ 'ตัวอักษร' (ข้อ 72) แนวตั้งนับ 'บรรทัด' — เขียนมือใช้พื้นที่มากกว่า จึงบรรทัดน้อยกว่าเครื่องพิมพ์"),
Q(90,"ข้อใดไม่ใช่ลักษณะงานที่ควรปรับปรุงวิธีทำงานให้ง่ายขึ้น",
 ["งานที่มีต้นทุนต่ำ","งานที่ใช้อัตรากำลังมาก","งานที่ทำซ้ำซ้อน","งานที่คั่งค้าง","งานที่ใช้เวลามาก"],1,
 "อ้างอิง: หน้า 159–160\n\nลักษณะงานที่ควรปรับปรุงวิธีทำงานให้ง่ายขึ้น\n1. งานที่คั่งค้าง\n2. งานที่ต้องเดินกลับไปกลับมา\n3. งานที่มีต้นทุนสูง\n4. งานที่ทำให้สิ้นเปลืองในด้านต่าง ๆ เช่น สิ้นเปลืองเวลา แรงงาน\n5. งานที่ต้องทำซ้ำซาก\n6. งานที่ต้องใช้อัตรากำลังคนมากเกินไป\n\nเทียบตัวเลือก: ข้อ 4 = ลักษณะที่ 1 / ข้อ 5 = ลักษณะที่ 4 (สิ้นเปลืองเวลา) / ข้อ 3 = ลักษณะที่ 5 (ซ้ำซาก) / ข้อ 2 = ลักษณะที่ 6\nข้อ 1 'ต้นทุนต่ำ' กลับกับลักษณะที่ 3 (ต้นทุนสูง) จึงไม่ใช่งานที่ต้องปรับปรุง\n\nกับดัก: ต้นทุน 'สูง' ต้องปรับปรุง ต้นทุน 'ต่ำ' ไม่ต้อง — โจทย์เป็นแบบ 'ไม่ใช่' ให้หาข้อที่กลับกัน"),
Q(91,"ตำแหน่งผู้บริหารงานสำนักงาน จำเป็นต้องมีคุณสมบัติในข้อใดสำคัญที่สุด",
 ["มอบหมายงานตรงกับความสามารถของคน","เป็นชาย สุภาพ","เป็นผู้มีบุคลิกความเป็นผู้นำ","มีการศึกษาสูง","มีไหวพริบ"],3,
 "อ้างอิง: หน้า 13–14\n\nหลักการ: ผู้บริหารงานสำนักงานต้องมีคุณสมบัติ 10 ข้อ\n1. มีความเป็นผู้นำ — เป็นคุณสมบัติที่สำคัญที่สุด\n2. มีไหวพริบ\n3. มีความมั่นคง\n4. มีสัมพันธไมตรี\n5. มีความสามารถในการมอบหมายงานให้ผู้อื่นทำ\n6. เป็นผู้มองการณ์ไกล\n7. มีการศึกษา\n8. มีความสามารถในการวิเคราะห์\n9. มีความสามารถด้านการจัดการ\n10. มีความสามารถในการขายความคิด\n\nข้อ 1 = ข้อ 5 / ข้อ 4 = ข้อ 7 / ข้อ 5 = ข้อ 2 ล้วนเป็นคุณสมบัติที่ดี แต่โจทย์ถามอันดับ 'สำคัญที่สุด' ชีทระบุว่าคือความเป็นผู้นำ ส่วน 'เป็นชาย' ไม่มีในรายการ\n\nวิธีจำ: ข้อ 1 ของรายการ = สำคัญที่สุด = ผู้นำ"),
Q(92,"หลักประสิทธิภาพในการจัดแผนผังสำนักงาน ข้อใดกล่าวผิด",
 ["จัดสายทางเดินของงานให้เป็นเส้นตรงไปข้างหน้า","จัดให้มีทางออกฉุกเฉินเพียงพอ","จัดโต๊ะให้หันหน้าไปทางเดียวกัน","จัดให้หน่วยงานใหญ่อยู่ในบริเวณใกล้กัน","จัดทางเดินระหว่างหน่วยงานให้โล่งโปร่ง"],4,
 "อ้างอิง: ดูข้อ 52 ประกอบ — หน้า 63–65\n\nหลักประสิทธิภาพในการจัดแผนผังสำนักงาน (Office Layout)\n1. จัดสายทางเดินของงานเป็นเส้นตรงไปข้างหน้า (หรือเป็นรูปวงกลม ตัว U หรือ L เพื่อลดการเคลื่อนไหวที่ไม่จำเป็น)\n2. จัดให้มีทางออกยามฉุกเฉินอย่างเพียงพอ\n3. จัดทางเดินระหว่างหน่วยงานให้โล่งโปร่ง\n4. จัดให้โต๊ะหันหน้าไปทางเดียวกัน โดยให้หัวหน้างานอยู่ด้านหลังพนักงาน\n5. หน่วยงานที่ให้บริการรวมแก่หน่วยงานอื่น ๆ ควรตั้งอยู่ใกล้กับหน่วยงานที่รับบริการนั้น\n6. จัดหน่วยงานใหญ่ไว้ไกลหน่วยงานเล็ก เพื่อความสะดวกเมื่อต้องการขยายหน่วยงาน\n\nข้อ 1 = หลักข้อ 1 / ข้อ 2 = ข้อ 2 / ข้อ 3 = ข้อ 4 / ข้อ 5 = ข้อ 3 ถูกทั้งหมด ส่วนข้อ 4 'หน่วยงานใหญ่อยู่ใกล้กัน' ขัดกับหลักข้อ 6 (หน่วยงานใหญ่ควรอยู่ไกลหน่วยงานเล็ก)\n\nวิธีจำข้อ 6: ใหญ่ไกลเล็ก (เผื่อขยายตัว)"),
Q(93,"ในกรณีของการจัดเรียงชื่อบุคคลที่ชื่อและสกุลเหมือนกันทุกประการ ให้พิจารณาเรียงลำดับอย่างไร",
 ["เรียงตาม วัน เดือน ปีที่เกิด","เรียงตามยศตำแหน่ง","เรียงตามลำดับที่บุคคลนั้นอาศัยอยู่","เรียงตามลำดับขั้นการศึกษา","เรียงตามอายุและเพศ"],2,
 " หลักการ: ในการเรียงชื่อบุคคล เรานำยศ ตำแหน่ง และคำนำหน้านามไปใส่ 'ไว้ในวงเล็บท้ายชื่อ' ไม่นำมาใช้เรียงตั้งแต่แรก (ข้อ 5, 6, 77) แต่ถ้าชื่อและนามสกุลเหมือนกันทุกประการ ซึ่งเรียงไม่ได้แล้ว ให้พิจารณาเรียงลำดับตามยศตำแหน่งที่อยู่ในวงเล็บนั้น\n\nวิธีจำ: ยศ/ตำแหน่ง = ตัวตัดสินสุดท้าย เมื่อชื่อ + นามสกุลเหมือนกัน"),
Q(94,"การย้ายเอกสารที่ปฏิบัติเสร็จแล้ว ไปเก็บในแหล่งเก็บเอกสารที่ไม่ค่อยได้ใช้ เพื่อให้มีที่ว่างสำหรับเก็บเอกสารได้สะดวก คืออะไร",
 ["การทำลายเอกสาร","การโอนเอกสาร","การรักษาเอกสาร","การทำบัญชีเอกสาร","ไม่มีข้อใดถูก"],2,
 "อ้างอิง: หน้า 201\n\nหลักการ: การโอนเอกสาร คือการย้ายเอกสารที่ปฏิบัติเสร็จสิ้นแล้ว (Inactive File) ไปเก็บในแหล่งเก็บเอกสารที่ไม่ค่อยได้ใช้ เพื่อให้มีที่ว่างสำหรับเก็บเอกสารที่ใช้งานอยู่ มี 2 วิธี\n1. วิธีโอนเป็นงวด ๆ (Periodic) — ได้รับความนิยมมากกว่า\n2. วิธีโอนติดต่อ (Perpetual) — มีโอกาสโอนอยู่เกือบตลอดเวลา จึงไม่ได้รับความนิยม\n\nการทำลายเอกสาร = ทิ้งเอกสารที่ไม่มีคุณค่า (Destruction) ซึ่งต่างจากการโอน (ยังเก็บอยู่ เพียงย้ายที่)\n\nวิธีจำ: โอน = ย้ายที่เก็บ ไม่ใช่ทิ้ง / Periodic = เป็นรอบ (นิยม) / Perpetual = ต่อเนื่องไม่หยุด (ไม่นิยม)",false,true),
Q(95,"การปรับปรุงระบบงาน โดยวิธีใดเหมาะสมที่สุดที่จะช่วยให้งานสำนักงานมีประสิทธิภาพมากขึ้น",
 ["การรวมงานที่คล้ายกันไว้ด้วยกัน","จัดหาเครื่องจักรที่มีราคาแพงมาใช้","การเพิ่มจำนวนพนักงานให้มากขึ้น","ผู้บริหารควบคุมเข้มงวด","การเพิ่มขั้นตอนการทำงานให้มากขึ้น"],1,
 "อ้างอิง: หน้า 157, 160\n\nหลักการ: การปรับปรุงระบบงานให้ดีขึ้นหรือมีประสิทธิภาพมากขึ้น ไม่ได้หมายความว่าพนักงานต้องทำงานให้หนักขึ้นหรือเร็วขึ้น แต่เป็นการหาวิธีทำงานให้ง่ายขึ้น เพื่อให้ประสิทธิภาพเพิ่มขึ้น โดยไม่จำเป็นต้องใช้เครื่องมือราคาแพงเสมอไป เช่น\n• การรวมงานที่คล้ายกันหรืองานอย่างเดียวกันเข้าไว้ด้วยกัน\n• การลดขั้นตอนการทำงานให้น้อยลง\n\nตัวเลือกที่ผิด: ข้อ 2 (เครื่องจักรแพง — ชีทบอกไม่จำเป็น) / ข้อ 3 (เพิ่มพนักงาน — เพิ่มต้นทุน) / ข้อ 4 (ควบคุมเข้มงวด — ไม่ใช่การทำให้งานง่าย) / ข้อ 5 (เพิ่มขั้นตอน — ตรงข้ามกับการลดขั้นตอน)\n\nวิธีจำ: ปรับปรุง = ทำให้ 'ง่ายขึ้น/น้อยลง' (รวมงาน ลดขั้นตอน) ไม่ใช่ 'หนักขึ้น/มากขึ้น'"),
Q(96,"รูปแบบรายงานทางการบริหารควรกำหนดให้ส่วนใดอยู่ในตอนเริ่มแรกของรายงาน",
 ["บทนำ","เนื้อหา","หัวข้อ","ภาคผนวก","รายงานสรุป"],5,
 "อ้างอิง: หน้า 261–262\n\nหลักการ: รูปแบบรายงานทางการบริหารมีองค์ประกอบพื้นฐาน 5 ขั้นตอน เรียงตามลำดับ\n1. รายงานสรุปหรือบันทึกข้อความ — ส่วนที่ควรอยู่ตอนเริ่มแรกของรายงาน\n2. สารบาญเรื่อง\n3. หัวข้อ\n4. เนื้อหา\n5. ภาคผนวก — ส่วนที่ควรอยู่ตอนท้ายของรายงาน\n\nเหตุผล: ผู้บริหารมีเวลาน้อย จึงต้องอ่านบทสรุปก่อน (ตรงกับข้อ 10 ที่ว่าควรจัดรายงานสรุปไว้ตอนเริ่มแรกของเล่ม) ภาคผนวกเป็นข้อมูลประกอบ จึงอยู่ท้ายเล่ม ('บทนำ' ไม่อยู่ในองค์ประกอบ 5 ขั้นนี้)\n\nวิธีจำ: สรุป – สารบาญ – หัวข้อ – เนื้อหา – ภาคผนวก (สรุปขึ้นก่อน ภาคผนวกท้ายสุด)"),
Q(97,"ข้อใดถูกต้องตามหลักเกณฑ์การจัดลำดับหน่วยเก็บ (ชื่อเดิม → ชื่อที่ใช้จัดเก็บ)",
 ["บริษัท ไลอ้อน (ประเทศไทย) จำกัด → ไลอ้อน จำกัด (ประเทศไทย) (บริษัท)","ห้างหุ้นส่วนจำกัด จ.เจริญจักรกล → จ.เจริญจักรกล จำกัด (ห้างหุ้นส่วน)","บริษัท จีเอ็มเอ็ม แกรมมี่ จำกัด (มหาชน) → จีเอ็มเอ็ม แกรมมี่ จำกัด บริษัท (มหาชน)","สำนักงานกฎหมาย นิติธรรม → กฎหมายนิติธรรม (สำนักงาน)","บริษัท แฟมิลีโฮม (1999) จำกัด → แฟมิลีโฮม (1999) (บริษัทจำกัด)"],2,
 "อ้างอิง: ดูข้อ 5 ประกอบ\n\nหลักการ (ข้อ 5, 8, 9): เวลาเก็บชื่อกิจการ ให้ย้ายคำบอกประเภทกิจการ (บริษัท ห้างหุ้นส่วน ร้าน สำนักงาน ฯลฯ) ไปไว้ใน 'วงเล็บท้ายสุด' ส่วนที่เหลือคือชื่อจริง ที่นำมาเรียง\n\nข้อ 2 ถูกต้อง: ห้างหุ้นส่วนจำกัด จ.เจริญจักรกล → ชื่อจริง 'จ.เจริญจักรกล จำกัด' + ประเภทกิจการ '(ห้างหุ้นส่วน)' ไว้ท้ายสุดในวงเล็บ\n\nวิเคราะห์ตัวเลือกที่ผิด\n• ข้อ 1: ชื่อ 'ไลอ้อน (ประเทศไทย)' เป็นส่วนของชื่อ จึงต้องเรียง 'ไลอ้อน ประเทศไทย จำกัด (บริษัท)' (เทียบข้อ 8: เนสท์เล่ ไทย จำกัด (บริษัท)) แต่ข้อ 1 ย้าย 'จำกัด' มาไว้ก่อน 'ประเทศไทย' และเอา 'ประเทศไทย' ไปไว้ในวงเล็บ\n• ข้อ 3: คำว่า 'บริษัท' ต้องอยู่ในวงเล็บ แต่ข้อนี้เขียน 'บริษัท' นอกวงเล็บ\n• ข้อ 5: ย้ายคำว่า 'จำกัด' เข้าไปในวงเล็บรวมเป็น '(บริษัทจำกัด)' ซึ่งไม่ตรงกับแนวของเฉลยข้อ 8 (จำกัด ยังคงอยู่กับชื่อ)\n• ข้อ 4: ประเภทกิจการคือ 'สำนักงานกฎหมาย' ทั้งวลี ต้องย้ายเข้าวงเล็บทั้งวลี เป็น นิติธรรม (สำนักงานกฎหมาย) แต่ตัวเลือกนี้ย้ายแค่ 'สำนักงาน' ทิ้ง 'กฎหมาย' ไว้กับชื่อ (เทียบชีทแดง 1/64 โจทย์ข้อ 72 'สราวัลย์ (สำนักงานบัญชี)' และข้อ 86 ตัวเลือก 4)\n\nหมายเหตุ: เฉลยของชีทเขียนคำว่า 'จำกัด' ต่างกันเล็กน้อยระหว่างข้อ 9 [วัชระภัณฑ์ (ห้างหุ้นส่วนจำกัด)] กับข้อนี้ [จ.เจริญจักรกล จำกัด (ห้างหุ้นส่วน)] ให้ตัดตัวเลือกที่ผิด (ข้อ 1, 3, 4, 5) แล้วจะเหลือข้อ 2"),
Q(98,"ข้อใดไม่ใช่เอกสาร Vital Files",
 ["ทะเบียนรถ","พันธบัตร","หุ้นกู้","ใบประมูลราคา","สัญญาว่าจ้าง"],4,
 "อ้างอิง: ดูข้อ 3 ประกอบ\n\nหลักการ: เอกสารคุณค่าสูง (Vital) ต้องเก็บตลอดไป ตัวอย่างในชีท ได้แก่ หนังสือสำคัญแสดงการเป็นเจ้าของกิจการ/ทรัพย์สิน/หนี้สิน (พันธบัตร หุ้นกู้ ทะเบียนรถ โฉนดที่ดิน งบแสดงฐานะการเงิน รายงานประจำปี) และหนังสือสัญญาต่าง ๆ (สัญญากับสหภาพแรงงาน ข้อตกลงกับลูกจ้าง สัญญาซื้อขายที่ดิน สัญญาว่าจ้างทำงาน)\n\nเทียบตัวเลือก: ทะเบียนรถ (ถูก) / พันธบัตร (ถูก) / หุ้นกู้ (ถูก) / สัญญาว่าจ้าง (ถูก) — ทั้ง 4 ข้ออยู่ในรายการ Vital ส่วน 'ใบประมูลราคา' ไม่อยู่ในรายการ (ใช้ชั่วคราวในช่วงประมูล)\n\nโจทย์ 'ไม่ใช่' → เลือกข้อที่ไม่อยู่ในรายการ Vital"),
Q(99,"การรายงานทางการบริหารจากเบื้องล่างขึ้นสู่เบื้องบนเป็นการรายงานในเรื่องใด",
 ["ผลการปฏิบัติงาน","ระเบียบข้อบังคับ","กติกา กฎเกณฑ์","นโยบาย คำสั่ง","แนวทางการปฏิบัติงาน"],1,
 "อ้างอิง: ดูข้อ 74 ประกอบ — หน้า 258\n\nหลักการ: การรายงานทางการบริหารมี 2 ทิศทาง\n• จากเบื้องบนลงสู่เบื้องล่าง = คำสั่ง นโยบาย แนวทางการปฏิบัติงาน กติกา กฎเกณฑ์ กฎระเบียบ ข้อบังคับ ข้อปฏิบัติต่าง ๆ (ข้อ 2, 3, 4, 5 ในข้อนี้)\n• จากเบื้องล่างขึ้นสู่เบื้องบน = ผลการดำเนินงานหรือการปฏิบัติงาน สภาพแวดล้อมขององค์การ สภาวะการแข่งขันกับคู่แข่งขัน การวิเคราะห์ความเป็นไปภายใน\n\nตัวเลือก 2–5 ล้วนเป็นสิ่งที่ผู้บริหาร 'สั่งลงมา' จึงผิดหมด เหลือข้อ 1\n\nวิธีจำ: ล่างขึ้นบน = 'รายงานผลงาน' / บนลงล่าง = 'สั่งการและกำหนดกติกา'"),
Q(100,"สัญลักษณ์นี้ ○ อธิบายถึงอะไร",
